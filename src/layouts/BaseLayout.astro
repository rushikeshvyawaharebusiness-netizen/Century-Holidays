---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QuickContact from '../components/QuickContact.astro';
import TravelerPopupModal from '../components/TravelerPopupModal.astro';
import '../styles/global.css';
import { ALL_KEYWORDS, BUSINESS, seoFor } from '../data/site';
import { travelAgencySchema, webSiteSchema } from '../data/schema';

interface Props {
  /** URL of this page, e.g. "/about.html". Its SEO is looked up from src/data/site.ts. */
  path: string;
  /** Optional one-off overrides. Normally leave these out and edit site.ts instead. */
  title?: string;
  description?: string;
  navVariant?: 'transparent' | 'solid';
  newsletterHeading?: string;
  /** Extra schema.org blocks for this page (FAQ, breadcrumbs). */
  structuredData?: Record<string, unknown>[];
  /** Pre-filled WhatsApp message for the floating contact widget. */
  quickContactMessage?: string;
}

const {
  path,
  navVariant = 'solid',
  newsletterHeading = 'Join the Club',
  structuredData = [],
  quickContactMessage,
} = Astro.props;

/*
  Page titles and descriptions live in src/data/site.ts so that all of the
  site's SEO copy can be reviewed and edited in one place. A page may still
  override them by passing `title`/`description` directly.
*/
const seo = seoFor(path);
const title = Astro.props.title ?? seo.title;
const description = Astro.props.description ?? seo.description;

const canonicalURL = new URL(path, Astro.site);
const ogImageURL = new URL('/og-cover.png', Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#15140f" />

    {/*
      SEO basics. Titles and descriptions come from PAGES in src/data/site.ts —
      edit them there, not here.
    */}
    {/*
      Pages marked `index: false` in src/data/site.ts (Terms, Privacy, Contact,
      Book) are kept out of Google entirely, so they can never be picked as
      sitelinks under the main result. `follow` still lets Google follow the
      links on them. Every other page is indexable.
    */}
    <meta
      name="robots"
      content={seo.index === false ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
    />
    <meta name="keywords" content={ALL_KEYWORDS} />
    <meta name="author" content={BUSINESS.name} />

    {/* Local-search signals for the Nashik / Pune / Mumbai terms. */}
    <meta name="geo.region" content="IN-MH" />
    <meta name="geo.placename" content={BUSINESS.address.city} />
    <meta name="geo.position" content={`${BUSINESS.geo.latitude};${BUSINESS.geo.longitude}`} />

    {/* How the page looks when shared on Facebook, WhatsApp, LinkedIn. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${BUSINESS.name} — ${BUSINESS.tagline}`} />

    {/* How the page looks when shared on X/Twitter. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {/*
      Structured data. The business + website entities go on every page; a page
      can pass extra blocks (FAQ, breadcrumbs) through the `structuredData` prop.
    */}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(travelAgencySchema(Astro.site))}
      is:inline
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(webSiteSchema(Astro.site))}
      is:inline
    />
    {structuredData.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://unpkg.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Outfit:wght@400;500;600;700;800;900&family=Syne:wght@700;800&display=swap"
      rel="stylesheet"
    />
    <script src="https://unpkg.com/@phosphor-icons/web" defer is:inline></script>
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="bg-paper text-text antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-brand focus:px-5 focus:py-3 focus:text-sm focus:font-bold focus:text-ink"
    >
      Skip to content
    </a>
    <Navbar variant={navVariant} activePath={path} />
    <slot />
    <Footer newsletterHeading={newsletterHeading} />
    <QuickContact message={quickContactMessage} />
    <TravelerPopupModal />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -60px 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

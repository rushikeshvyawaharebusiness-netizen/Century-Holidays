---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import QuickContact from '../components/QuickContact.astro';
import TravelerPopupModal from '../components/TravelerPopupModal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  navVariant?: 'transparent' | 'solid';
  newsletterHeading?: string;
  structuredData?: Record<string, unknown>;
  /** Pre-filled WhatsApp message for the floating contact widget. */
  quickContactMessage?: string;
}

const {
  title,
  description,
  path,
  navVariant = 'solid',
  newsletterHeading = 'Join the Club',
  structuredData,
  quickContactMessage,
} = Astro.props;

const canonicalURL = new URL(path, Astro.site);
const ogImageURL = new URL('/og-cover.png', Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#15140f" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://unpkg.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,500&family=Outfit:wght@300;400;500;600;700;800;900&family=Syne:wght@700;800&family=Unbounded:wght@700;800;900&display=swap"
      rel="stylesheet"
    />
    <script src="https://unpkg.com/@phosphor-icons/web" defer is:inline></script>
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="bg-paper text-text antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-brand focus:px-5 focus:py-3 focus:text-sm focus:font-bold focus:text-ink"
    >
      Skip to content
    </a>
    <Navbar variant={navVariant} activePath={path} />
    <slot />
    <Footer newsletterHeading={newsletterHeading} />
    <QuickContact message={quickContactMessage} />
    <TravelerPopupModal />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -60px 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PHONE_DISPLAY, PHONE_HREF, EMAIL, EMAIL_HREF } from '../data/contact';

const certifications = [
  {
    icon: 'ph-seal-check',
    title: 'Government Registered Agency',
    badge: 'Official License',
    description:
      'Fully registered and licensed tourism enterprise operating in full compliance with state and central tourism mandates, commercial licensing, and consumer protection protocols.',
  },
  {
    icon: 'ph-mountains',
    title: 'Certified Mountain & Trail Safety',
    badge: 'Safety Standards',
    description:
      'Strict adherence to high-altitude safety guidelines, certified local trail leads (NIM / WFR trained), emergency oxygen support contingencies, and verified hill transport.',
  },
  {
    icon: 'ph-shield-check',
    title: '100% Financial Transparency',
    badge: 'GST Invoicing',
    description:
      'Transparent, itemized pricing with full GST tax compliance, official digital receipts, zero hidden on-ground surcharges, and clear, upfront booking policies.',
  },
  {
    icon: 'ph-certificate',
    title: 'Verified Ground Fleet & Partner Network',
    badge: 'Vetted Partners',
    description:
      'Direct commercial agreements with certified vehicle fleets, seasoned mountain drivers with verified safety records, and inspected boutique hotels and homestays.',
  },
];
import { breadcrumbSchema } from '../data/schema';

/* Breadcrumb trail, so Google shows "Home > About Us" instead of a raw URL. */
const structuredData = [
  breadcrumbSchema(Astro.site, [
    { name: 'Home', path: '/' },
    { name: "About Us", path: '/about.html' },
  ]),
];
---

<BaseLayout
  path="/about.html"
  structuredData={structuredData}
>
  <main id="main-content" class="bg-paper text-ink">
    <!-- Header Section -->
    <section class="border-b border-border bg-surface pb-16 pt-32 sm:pb-20 sm:pt-40">
      <div class="container-page max-w-4xl text-center">
        <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-ink-muted">
          Century Holidays • Est. 2018
        </span>
        <h1 class="mt-3 font-display text-4xl text-ink sm:text-5xl lg:text-6xl">
          Our Story
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-text-muted sm:text-lg">
          Rooted in Nashik, Maharashtra — built on genuine regional knowledge, local stewardship, and verified operational standards.
        </p>
      </div>
    </section>

    <!-- Company Story Section (Clean Editorial Typography, No Images) -->
    <section class="py-16 sm:py-24">
      <div class="container-page max-w-3xl">
        <div class="space-y-6 text-base leading-relaxed text-text-muted sm:text-lg">
          <p class="font-display text-xl leading-relaxed text-ink sm:text-2xl">
            Founded in 2018 in Nashik, Maharashtra, Century Holidays was established with a straightforward mission: to bring authentic personal care, regional ground knowledge, and complete operational transparency back to travel planning.
          </p>

          <p>
            In an industry increasingly driven by automated aggregators and impersonal booking portals, we believe that true travel cannot be mass-produced. Real expeditions across rugged Himalayan passes, sacred pilgrimages like Char Dham, or relaxing international holidays require guidance from specialists who personally understand the terrain.
          </p>

          <p>
            Over the years, we have built trusted, long-term partnerships with certified local guides, seasoned mountain drivers, monastery custodians, and vetted boutique stays across India and popular international destinations. By working directly with trusted on-ground operators, we eliminate unnecessary middlemen, ensuring our travelers receive exceptional value, safety, and an authentic experience from start to finish.
          </p>
        </div>

        <!-- Guiding Commitments -->
        <div class="mt-12 rounded-2xl border border-border bg-surface p-7 sm:p-8 shadow-xs">
          <h2 class="text-xs font-bold uppercase tracking-widest text-ink-muted">
            Our Core Commitments
          </h2>
          <div class="mt-6 grid gap-5 sm:grid-cols-3">
            <div class="flex flex-col gap-2">
              <i class="ph-bold ph-seal-check text-2xl text-ink" aria-hidden="true"></i>
              <h3 class="font-display text-base font-bold text-ink">Vetted Partners</h3>
              <p class="text-xs leading-relaxed text-text-muted sm:text-sm">
                Every route, driver, and accommodation is inspected and tested by our team.
              </p>
            </div>
            <div class="flex flex-col gap-2">
              <i class="ph-bold ph-shield-check text-2xl text-ink" aria-hidden="true"></i>
              <h3 class="font-display text-base font-bold text-ink">Transparent Pricing</h3>
              <p class="text-xs leading-relaxed text-text-muted sm:text-sm">
                100% itemized billing, legal GST invoices, and zero hidden on-ground surcharges.
              </p>
            </div>
            <div class="flex flex-col gap-2">
              <i class="ph-bold ph-headset text-2xl text-ink" aria-hidden="true"></i>
              <h3 class="font-display text-base font-bold text-ink">Dedicated Support</h3>
              <p class="text-xs leading-relaxed text-text-muted sm:text-sm">
                A single, continuous point of contact on call throughout your entire journey.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Agency Certifications Section (Elevated, Simple, Professional) -->
    <section class="border-t border-border bg-surface-muted/50 py-16 sm:py-24">
      <div class="container-page max-w-4xl">
        <div class="text-center">
          <span class="text-xs font-bold uppercase tracking-widest text-ink-muted">
            Official Compliance & Accreditation
          </span>
          <h2 class="mt-2 font-display text-3xl sm:text-4xl text-ink">
            Agency Certifications & Standards
          </h2>
          <p class="mx-auto mt-3 max-w-2xl text-base text-text-muted">
            Century Holidays operates under formal commercial registration, adhering strictly to government tourism regulations, passenger safety mandates, and financial ethics.
          </p>
        </div>

        <!-- 2x2 Certifications Grid -->
        <div class="mt-12 grid gap-6 sm:grid-cols-2">
          {certifications.map((cert) => (
            <div class="rounded-2xl border border-border bg-surface p-7 shadow-xs transition-shadow duration-200 hover:shadow-card">
              <div class="flex items-center justify-between">
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-surface-muted text-ink">
                  <i class:list={['ph-bold text-2xl', cert.icon]} aria-hidden="true"></i>
                </span>
                <span class="rounded-full bg-[#F0EA1B]/20 border border-[#F0EA1B]/50 px-3 py-0.5 text-xs font-bold text-gray-900">
                  {cert.badge}
                </span>
              </div>
              <h3 class="mt-5 font-display text-xl font-bold text-ink">{cert.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-text-muted">{cert.description}</p>
            </div>
          ))}
        </div>

        <!-- Official Office & Registration Information Card -->
        <div class="mt-10 rounded-2xl border border-border bg-surface p-7 sm:p-8 shadow-xs">
          <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
            <div class="lg:col-span-8">
              <h3 class="font-display text-xl font-bold text-ink">Registered Head Office & Contact</h3>
              <p class="mt-2 text-sm text-text-muted">
                Clients and partners are welcome to visit our office in Nashik or reach out directly to our operations desk.
              </p>
              <div class="mt-5 space-y-3 text-sm text-text-muted">
                <div class="flex items-start gap-3">
                  <i class="ph-bold ph-map-pin mt-1 text-ink text-base" aria-hidden="true"></i>
                  <span>
                    <strong class="text-ink font-semibold">Address:</strong> 4th Floor, Trinity Towers, Near Jairam Glass, Tidke Colony, Nashik, Maharashtra 422002
                  </span>
                </div>
                <div class="flex items-center gap-3">
                  <i class="ph-bold ph-phone text-ink text-base" aria-hidden="true"></i>
                  <span>
                    <strong class="text-ink font-semibold">Direct Helpline:</strong> <a href={PHONE_HREF} class="hover:text-ink font-semibold underline decoration-border">{PHONE_DISPLAY}</a> (Mon – Sat, 9:30 AM – 7:30 PM)
                  </span>
                </div>
                <div class="flex items-center gap-3">
                  <i class="ph-bold ph-envelope text-ink text-base" aria-hidden="true"></i>
                  <span>
                    <strong class="text-ink font-semibold">Official Email:</strong> <a href={EMAIL_HREF} class="hover:text-ink font-semibold underline decoration-border">{EMAIL}</a>
                  </span>
                </div>
              </div>
            </div>

            <div class="flex flex-col items-start lg:items-end lg:col-span-4 border-t border-border pt-6 lg:border-t-0 lg:border-l lg:pl-8 lg:pt-0">
              <span class="text-xs font-bold uppercase tracking-wider text-ink-muted">Need Assistance?</span>
              <p class="mt-1 text-xs text-text-muted lg:text-right">Connect with our team directly for custom itinerary inquiries.</p>
              <a
                href={PHONE_HREF}
                class="mt-4 inline-flex items-center gap-2 rounded-full bg-[#F0EA1B] px-6 py-2.5 text-sm font-bold text-gray-950 shadow-xs transition-transform duration-200 hover:-translate-y-0.5 hover:bg-[#e4de16]"
              >
                <i class="ph-bold ph-phone" aria-hidden="true"></i>
                Call {PHONE_DISPLAY}
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

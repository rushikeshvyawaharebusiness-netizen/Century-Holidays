---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import storyPhoto from '../assets/images/banner-spiti-hd.jpg';

const certifications = [
  {
    icon: 'ph-seal-check',
    title: 'Government Registered Agency',
    badge: 'Official License',
    description:
      'Fully recognized and legally registered travel operating enterprise adhering to state and national tourism regulations, business ethics, and passenger consumer protection norms.',
  },
  {
    icon: 'ph-first-aid',
    title: 'Certified Mountain & Trail Safety',
    badge: 'Safety First',
    description:
      'Strict adherence to high-altitude safety guidelines, certified local guides, medical-grade oxygen contingencies, and verified hill-certified commercial transport partners.',
  },
  {
    icon: 'ph-receipt',
    title: '100% Financial Transparency',
    badge: 'GST Invoicing',
    description:
      'Transparent itemized pricing with full GST compliance, official digital receipts, zero hidden fees, and clear, upfront cancellation and refund policies.',
  },
  {
    icon: 'ph-shield-check',
    title: 'Verified Ground Fleet & Stays',
    badge: 'Vetted Partners',
    description:
      'Direct contracts with certified commercial transport operators, seasoned hill drivers, and inspected boutique properties, homestays, and hotels across all destinations.',
  },
];
---

<BaseLayout
  title="About Us - Company Story & Certifications | Century Holidays"
  description="Discover the story behind Century Holidays, an accredited travel agency based in Nashik. Learn about our founding, philosophy, and official agency certifications."
  path="/about.html"
>
  <main id="main-content" class="bg-paper text-ink">
    <!-- Clean Minimalist Header -->
    <section class="border-b border-border bg-surface py-16 pt-32 sm:py-20 sm:pt-40">
      <div class="container-page text-center">
        <span class="inline-block text-xs font-bold uppercase tracking-[0.2em] text-ink-muted">
          About Century Holidays • Est. 2018
        </span>
        <h1 class="mt-3 font-display text-4xl text-ink sm:text-5xl lg:text-6xl">
          Our Story & Certifications
        </h1>
        <p class="mx-auto mt-4 max-w-2xl text-base text-text-muted sm:text-lg">
          Rooted in Nashik, Maharashtra, we are a certified travel company dedicated to human-led, transparent, and authentic travel experiences.
        </p>
      </div>
    </section>

    <!-- Company Story Section -->
    <section class="py-16 sm:py-24">
      <div class="container-page">
        <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
          <!-- Real HD Photography -->
          <div class="lg:col-span-6">
            <div class="overflow-hidden rounded-2xl border border-border bg-surface shadow-card">
              <Image
                src={storyPhoto}
                alt="Century Holidays travelers on a mountain trail overlooking the Spiti river valley"
                class="aspect-[4/3] w-full object-cover"
                widths={[640, 1024]}
                sizes="(min-width: 1024px) 560px, 90vw"
                loading="eager"
              />
              <div class="border-t border-border bg-surface p-4 text-xs text-text-muted sm:text-sm">
                <span class="font-bold text-ink">Spiti Valley Expedition:</span> Real on-ground travel photograph taken during a Century Holidays mountain expedition.
              </div>
            </div>
          </div>

          <!-- Story Text Content -->
          <div class="lg:col-span-6">
            <span class="text-xs font-bold uppercase tracking-widest text-ink-muted">
              Company Story
            </span>
            <h2 class="mt-2 font-display text-3xl sm:text-4xl text-ink">
              Building Meaningful Travel Through Real Ground Knowledge
            </h2>

            <div class="mt-6 space-y-4 text-base leading-relaxed text-text-muted sm:text-lg">
              <p>
                Founded in 2018 in Nashik, Maharashtra, <strong class="text-ink font-semibold">Century Holidays</strong> was established with a singular objective: to bring genuine personal care, local expertise, and transparent operations back to travel planning.
              </p>
              <p>
                In an industry increasingly dominated by impersonal algorithms and automated booking portals, we believe that memorable travel requires human connection. Whether navigating a high Himalayan mountain pass, undertaking a sacred pilgrimage like Char Dham, or embarking on an international family holiday, travelers deserve guidance from someone who truly understands the terrain.
              </p>
              <p>
                Over the years, we have cultivated direct, reliable partnerships with local guides, experienced hill drivers, monastery custodians, and vetted boutique hotels across India and overseas. By working directly with trusted ground partners, we eliminate middlemen and ensure that every itinerary is paced realistically, prioritizing safety, comfort, and authenticity.
              </p>
            </div>

            <!-- Core Guiding Principles -->
            <div class="mt-8 border-t border-border pt-6">
              <h3 class="text-sm font-bold uppercase tracking-wider text-ink">Our Guiding Commitments</h3>
              <ul class="mt-3 space-y-2 text-sm text-text-muted sm:text-base">
                <li class="flex items-center gap-2.5">
                  <i class="ph-fill ph-check-circle text-green-600" aria-hidden="true"></i>
                  <span>Personally vetted routes, accommodations, and drivers</span>
                </li>
                <li class="flex items-center gap-2.5">
                  <i class="ph-fill ph-check-circle text-green-600" aria-hidden="true"></i>
                  <span>Honest, transparent pricing with zero hidden surcharges</span>
                </li>
                <li class="flex items-center gap-2.5">
                  <i class="ph-fill ph-check-circle text-green-600" aria-hidden="true"></i>
                  <span>Dedicated, continuous human assistance throughout your journey</span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Agency Certifications Section -->
    <section class="border-t border-border bg-surface-muted/50 py-16 sm:py-24">
      <div class="container-page">
        <div class="max-w-2xl">
          <span class="text-xs font-bold uppercase tracking-widest text-ink-muted">
            Official Compliance
          </span>
          <h2 class="mt-2 font-display text-3xl sm:text-4xl text-ink">
            Agency Certifications & Standards
          </h2>
          <p class="mt-3 text-base text-text-muted sm:text-lg">
            Century Holidays operates with formal commercial registration, strict adherence to tourism standards, and full operational transparency.
          </p>
        </div>

        <!-- Certifications 2x2 Grid -->
        <div class="mt-12 grid gap-6 sm:grid-cols-2">
          {certifications.map((cert) => (
            <div class="rounded-2xl border border-border bg-surface p-7 shadow-xs">
              <div class="flex items-center justify-between">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-surface-muted text-ink">
                  <i class:list={['ph-bold text-2xl', cert.icon]} aria-hidden="true"></i>
                </span>
                <span class="rounded-full bg-[#F0EA1B]/20 border border-[#F0EA1B]/40 px-3 py-1 text-xs font-bold text-gray-900">
                  {cert.badge}
                </span>
              </div>
              <h3 class="mt-5 font-display text-xl font-bold text-ink">{cert.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-text-muted sm:text-base">{cert.description}</p>
            </div>
          ))}
        </div>

        <!-- Official Office & Registration Information Card -->
        <div class="mt-10 rounded-2xl border border-border bg-surface p-7 sm:p-8 shadow-xs">
          <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
            <div class="lg:col-span-8">
              <h3 class="font-display text-xl font-bold text-ink">Registered Office & Contact Details</h3>
              <p class="mt-2 text-sm text-text-muted">
                Clients and partners are welcome to visit our head office or reach out to our administration team directly.
              </p>
              <div class="mt-5 space-y-3 text-sm sm:text-base text-text-muted">
                <div class="flex items-start gap-3">
                  <i class="ph-bold ph-map-pin mt-1 text-ink text-lg" aria-hidden="true"></i>
                  <span>
                    <strong class="text-ink font-semibold">Head Office:</strong> 4th Floor, Trinity Towers, Near Jairam Glass, Tidke Colony, Nashik, Maharashtra 422002
                  </span>
                </div>
                <div class="flex items-center gap-3">
                  <i class="ph-bold ph-phone text-ink text-lg" aria-hidden="true"></i>
                  <span>
                    <strong class="text-ink font-semibold">Telephone:</strong> <a href="tel:+918055253666" class="hover:text-ink underline decoration-border">+91 8055253666</a> (Mon – Sat, 9:30 AM – 7:30 PM)
                  </span>
                </div>
                <div class="flex items-center gap-3">
                  <i class="ph-bold ph-envelope text-ink text-lg" aria-hidden="true"></i>
                  <span>
                    <strong class="text-ink font-semibold">Official Email:</strong> <a href="mailto:contact@centuryholidays.in" class="hover:text-ink underline decoration-border">contact@centuryholidays.in</a>
                  </span>
                </div>
              </div>
            </div>

            <div class="flex flex-col items-start lg:items-end lg:col-span-4 border-t border-border pt-6 lg:border-t-0 lg:border-l lg:pl-8 lg:pt-0">
              <span class="text-xs font-bold uppercase tracking-wider text-ink-muted">Have Inquiries?</span>
              <p class="mt-1 text-xs text-text-muted lg:text-right">Speak directly with our senior travel managers.</p>
              <a
                href="/contact.html"
                class="mt-4 inline-flex items-center gap-2 rounded-full bg-[#F0EA1B] px-6 py-2.5 text-sm font-bold text-gray-950 transition-colors hover:bg-[#e4de16]"
              >
                Contact Agency <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

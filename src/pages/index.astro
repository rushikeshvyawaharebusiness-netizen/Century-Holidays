---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import MarqueeTrack from '../components/MarqueeTrack.astro';
import TripCard from '../components/TripCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import WhyUsSection from '../components/WhyUsSection.astro';
import FaqItem from '../components/FaqItem.astro';
import PosterSlider from '../components/PosterSlider.astro';
// Previous hero background — kept in assets, swap the import below to revert:
// import heroImage from '../assets/images/background.jpg';
import heroImage from '../assets/images/hero-valley.jpg';
import customer1 from '../assets/images/customer1.jpg';
import customer2 from '../assets/images/customer2.jpg';
import customer3 from '../assets/images/customer3.jpg';
import customer4 from '../assets/images/customer4.jpg';
import customer5 from '../assets/images/customer5.jpg';
import SideScrollingBanners from '../components/SideScrollingBanners.astro';
import DestinationCircles from '../components/DestinationCircles.astro';
import SpecialitiesSection from '../components/SpecialitiesSection.astro';
import GoogleIcon from '../components/icons/GoogleIcon.astro';
import InstagramIcon from '../components/icons/InstagramIcon.astro';
import { destinations, trending } from '../data/trips';
import { PHONE_E164, SOCIAL, whatsappLink } from '../data/contact';

const categories = [
  { image: customer1, alt: 'Century Holidays Happy Traveler - Trekking Adventure Experience', title: 'Happy Travelers', description: 'Unforgettable moments captured on our trips.' },
  { image: customer2, alt: 'Century Holidays Adventure Seeker - Mountain Peak Success', title: 'Adventure Seekers', description: 'Making memories that last a lifetime.' },
  { image: customer3, alt: 'Century Holidays Group Tour - Friends Travel Memories', title: 'Group Fun', description: 'Because the best memories are made with friends.' },
  { image: customer4, alt: 'Century Holidays Scenic Escape - Nature Exploration', title: 'Scenic Escapes', description: 'Journey into the heart of nature.' },
  { image: customer5, alt: 'Century Holidays Unforgettable Experience - Cultural Immersion', title: 'Unforgettable Experiences', description: 'Step out of your comfort zone.' },
];

const faqs = [
  {
    question: 'What is Century Holidays?',
    answer: 'We are a premier travel agency dedicated to curated group treks, bespoke international holidays, and domestic expeditions with zero middlemen and 100% on-ground support.',
    open: true,
  },
  {
    question: 'How do I book a tour with Century Holidays?',
    answer: 'You can book directly by clicking "Book Now" on our website, exploring our destination packages, or connecting directly with our travel specialists on WhatsApp at +91 7066187551 for instant reservation assistance.',
  },
  {
    question: 'How much advance payment is required to confirm a booking?',
    answer: 'Typically, a 30% advance deposit secures your booking slot. The remaining balance is cleared closer to the departure date depending on international flight and hotel arrangements.',
  },
  {
    question: 'Is the advance payment refundable if I cancel my trip?',
    answer: 'Refund policies depend on the destination package and the timing of your cancellation. We provide transparent cancellation schedules and flexible rescheduling vouchers for eligible trips.',
  },
  {
    question: 'Can trips be customized for private groups, families, or couples?',
    answer: 'Yes! In addition to our popular fixed group departures, our travel specialists design 100% customized private itineraries tailored to your dates, pace, hotel preferences, and budget.',
  },
  {
    question: 'Do you assist with flights, visas, and travel insurance?',
    answer: 'Absolutely. We provide end-to-end guidance on visa documentation, embassy appointments, domestic and international flight ticketing, and comprehensive medical travel insurance.',
  },
  {
    question: 'Are solo travelers welcome on your group trips?',
    answer: 'Over 50% of our travelers join solo! Our group tours provide a safe, welcoming, and vibrant social environment led by verified trip captains where solo adventurers make lifelong friends.',
  },
  {
    question: 'What kind of accommodation and transport is provided?',
    answer: 'We partner exclusively with verified 3-star to 5-star boutique hotels, premium resorts, and luxury glamping sites. All ground transfers use sanitized private vehicles (Force Travellers, SUVs, or luxury coaches) with licensed professional drivers.',
  },
  {
    question: 'Do you provide 24/7 on-ground assistance during the tour?',
    answer: 'Yes, around the clock. From your arrival airport pickup until your return flight home, our experienced on-ground trip captains and 24/7 emergency support desk are always just a phone call or WhatsApp message away.',
  },
  {
    question: 'What safety and medical measures are taken for high-altitude treks?',
    answer: 'For Himalayan treks (Ladakh, Spiti, Kedarkantha), we enforce strict acclimatization schedules and provide portable oxygen cylinders, comprehensive first-aid kits, pulse oximeters, and certified mountaineering guides.',
  },
  {
    question: 'When will I receive my final itinerary and trip coordinator details?',
    answer: 'Your day-wise tour vouchers, hotel vouchers, packing checklist, and dedicated trip captain contact details are shared in an exclusive WhatsApp briefing group 3 to 5 days prior to your departure.',
  },
  {
    question: 'What should I pack for international trips or trekking expeditions?',
    answer: 'Upon booking confirmation, you will receive a detailed packing checklist tailored specifically to your destination, season, and activities—covering thermal layers, trekking footwear, rain gear, and essential medicines.',
  },
  {
    question: 'Are meals included in your tour packages?',
    answer: 'Most packages include daily buffet breakfasts and select dinners at your accommodation, as outlined in each trip itinerary. Lunches are often kept open so you can explore local regional cafes and authentic food spots.',
  },
  {
    question: 'What payment methods do you accept?',
    answer: 'We accept all major secure payment methods including UPI (Google Pay, PhonePe, Paytm), Credit Cards, Debit Cards, Net Banking, and direct IMPS/NEFT transfers with official GST invoices.',
  },
  {
    question: 'How can I reach Century Holidays for urgent inquiries or support?',
    answer: 'You can call us directly on +91 7066187551, WhatsApp our support desk, email contact@centuryholidays.in, or visit our office on the 4th Floor, Trinity Towers, Tidke Colony, Nashik, Maharashtra.',
  },
];

const initialFaqs = faqs.slice(0, 10);
const extraFaqs = faqs.slice(10);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TravelAgency',
  name: 'Century Holidays',
  image: 'https://new-century-holidays-website.vercel.app/logo.png',
  url: 'https://new-century-holidays-website.vercel.app/',
  telephone: PHONE_E164,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '4th floor, Trinity Towers, near Jairam Glass, Tidke Colony',
    addressLocality: 'Nashik',
    addressRegion: 'Maharashtra',
    postalCode: '422002',
    addressCountry: 'IN',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 19.9975,
    longitude: 73.7898,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '09:00',
    closes: '20:00',
  },
  sameAs: [SOCIAL.facebook, SOCIAL.instagram, 'https://twitter.com/centuryholidays'],
};
---

<BaseLayout
  title="Century Holidays - Best Travel Agency for Adventure & Custom Tours"
  description="Century Holidays is your premier travel partner for curated adventure treks, customized tours, and unforgettable travel experiences. Based in Nashik, we offer premium holiday packages worldwide. Creating memories for every Century."
  path="/"
  navVariant="transparent"
  newsletterHeading="Join the Century Club"
  structuredData={structuredData}
>
  <main id="main-content">
    <!-- Hero -->
    <header id="home" class="relative flex min-h-screen min-h-[100dvh] flex-col justify-between pt-24 pb-0 sm:pt-28">
      <div class="absolute inset-0 -z-10 overflow-hidden">
        <Image
          src={heroImage}
          alt="Travellers overlooking a Himalayan valley from their tour vehicle"
          class="h-full w-full scale-150 object-cover object-[68%_88%] sm:scale-125 sm:object-[65%_75%] lg:scale-110 lg:object-[62%_100%]"
          widths={[768, 1280, 1920]}
          sizes="100vw"
          priority
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/20 to-transparent lg:bg-gradient-to-r lg:from-ink/0 lg:via-ink/0 lg:to-ink/85"></div>
        <div class="absolute inset-0 bg-ink/25 lg:hidden"></div>
      </div>

      <!-- Main Hero Content (Vertically centered) -->
      <div class="container-page w-full my-auto py-8">
        <div class="mx-auto max-w-2xl text-center lg:ml-auto lg:mr-0 lg:text-right">
          <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-6xl xl:text-7xl font-bold leading-[1.12] text-text-inverse tracking-tight">
            Crafting memories for <span class="text-brand">every century</span>
          </h1>
          <p class="mt-5 text-base sm:text-lg text-text-inverse-muted leading-relaxed max-w-xl mx-auto lg:ml-auto lg:mr-0">
            Join us for unforgettable treks, customized tours and premium travel experiences.
            Your next great adventure awaits.
          </p>
          <div class="mt-8 sm:mt-10 flex flex-wrap justify-center gap-4 lg:justify-end">
            <a
              href="#destinations"
              class="inline-flex items-center gap-2 rounded-full bg-brand px-7 py-3.5 text-base font-bold text-ink transition-transform duration-200 hover:-translate-y-0.5 hover:shadow-card-hover"
            >
              Explore Destinations <i class="ph-bold ph-arrow-right" aria-hidden="true"></i>
            </a>
            <a
              href="/book.html"
              class="inline-flex items-center gap-2 rounded-full border-2 border-text-inverse/30 px-7 py-3.5 text-base font-bold text-text-inverse transition-colors hover:border-brand hover:bg-brand hover:text-ink"
            >
              Book Now
            </a>
          </div>
        </div>
      </div>

      <!-- Hero Bottom Trust Strip (Matching Reference Image) -->
      <div class="relative z-20 w-full bg-surface border-y border-border shadow-xs">
        <div class="container-page flex flex-wrap items-center justify-center gap-6 sm:gap-12 md:gap-16 py-3.5 sm:py-4">
          <!-- 1. Instagram Community -->
          <a
            href={SOCIAL.instagram}
            target="_blank"
            rel="noopener"
            class="group flex items-center gap-2.5 transition-transform duration-200 hover:scale-105"
          >
            <InstagramIcon class="h-5 w-5 sm:h-5.5 sm:w-5.5 shrink-0" />
            <span class="text-xs sm:text-sm font-bold tracking-tight text-ink group-hover:text-brand">
              @centuryholidays
            </span>
          </a>

          <!-- 2. Google Reviews (Numbers scroll from 100 to 300) -->
          <div class="flex items-center gap-1.5 sm:gap-2">
            <GoogleIcon class="h-4.5 w-4.5 sm:h-5 sm:w-5 shrink-0" />
            <i class="ph-fill ph-star text-base sm:text-lg text-[#F59E0B] shrink-0" aria-hidden="true"></i>
            <span class="text-xs sm:text-sm font-bold tracking-tight text-ink tabular-nums whitespace-nowrap">
              4.9(<span id="counter-reviews">100</span>+ Reviews)
            </span>
          </div>

          <!-- 3. Travellers (Numbers scroll from 2,000 to 7,000) -->
          <div class="flex items-center gap-2">
            <div class="flex items-center justify-center h-6 w-6 rounded-full bg-brand/25 text-ink shrink-0">
              <i class="ph-bold ph-users-three text-base" aria-hidden="true"></i>
            </div>
            <span class="text-xs sm:text-sm font-bold tracking-tight text-ink tabular-nums whitespace-nowrap">
              <span id="counter-travellers">2,000</span>+ Travellers
            </span>
          </div>
        </div>
      </div>
    </header>

    <!-- Destinations (Image 2 Style Cards) -->
    <section id="destinations" class="bg-surface py-16 sm:py-24">
      <div class="container-page">
        <div data-reveal class="mb-10 flex flex-col items-center text-center">
          <span class="mb-2 text-sm font-bold uppercase tracking-[0.2em] text-ink-muted">Curated Adventures</span>
          <h2 class="text-balance font-display text-4xl text-ink sm:text-5xl lg:text-6xl">Explore Destinations</h2>
          <p class="mt-4 max-w-xl text-lg text-text-muted">
            Discover our hand-picked international tours and weekend escapes — pure adventure, authentic moments.
          </p>

          <!-- Destination Filter Tabs (Image 1 Style Pill Filter) -->
          <div class="mt-8 flex flex-wrap justify-center gap-2.5 sm:gap-3" id="destination-filter-tabs">
            <button
              type="button"
              class="dest-filter-pill active rounded-full px-5 py-2 text-sm font-bold transition-all duration-200 bg-brand text-ink shadow-sm"
              data-filter="all"
            >
              All Adventures
            </button>
            <button
              type="button"
              class="dest-filter-pill rounded-full border border-border bg-surface-muted px-5 py-2 text-sm font-bold transition-all duration-200 text-ink-muted hover:bg-border hover:text-ink"
              data-filter="international"
            >
              International Escapes
            </button>
            <button
              type="button"
              class="dest-filter-pill rounded-full border border-border bg-surface-muted px-5 py-2 text-sm font-bold transition-all duration-200 text-ink-muted hover:bg-border hover:text-ink"
              data-filter="domestic"
            >
              Weekend Getaways
            </button>
          </div>
        </div>

        {/* 8-Card Responsive Grid Matching Image 2 with generous spacing */}
        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 lg:gap-8 xl:gap-10 gap-y-10 sm:gap-y-12 justify-items-center"
          id="destination-cards-grid"
        >
          {destinations.map((trip) => (
            <div class="dest-card-item w-full flex justify-center px-1.5" data-scope={trip.scope}>
              <TripCard trip={trip} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <script>
      function initDestFilters() {
        const pills = document.querySelectorAll<HTMLButtonElement>('.dest-filter-pill');
        const cards = document.querySelectorAll<HTMLElement>('.dest-card-item');

        pills.forEach((pill) => {
          pill.addEventListener('click', () => {
            pills.forEach((p) => {
              p.classList.remove('active', 'bg-brand', 'text-ink', 'shadow-sm');
              p.classList.add('border', 'border-border', 'bg-surface-muted', 'text-ink-muted');
            });

            pill.classList.add('active', 'bg-brand', 'text-ink', 'shadow-sm');
            pill.classList.remove('border', 'border-border', 'bg-surface-muted', 'text-ink-muted');

            const filter = pill.getAttribute('data-filter');
            cards.forEach((card) => {
              const scope = card.getAttribute('data-scope');
              if (filter === 'all' || scope === filter) {
                card.style.display = 'flex';
              } else {
                card.style.display = 'none';
              }
            });
          });
        });
      }

      initDestFilters();
      document.addEventListener('astro:page-load', initDestFilters);
    </script>

    <!-- Trending -->
    <section id="trending" class="bg-paper py-20 sm:py-28">
      <div class="container-page">
        <div data-reveal class="mb-14 flex flex-col items-center text-center">
          <span class="mb-2 text-sm font-bold uppercase tracking-[0.2em] text-ink-muted">Discover The Best</span>
          <h2 class="text-balance font-display text-4xl text-ink sm:text-5xl lg:text-6xl">Trending Trips</h2>
          <p class="mt-4 max-w-xl text-lg text-text-muted">
            Handpicked destinations for your next unforgettable journey.
          </p>
        </div>
      </div>

      <MarqueeTrack reverse>
        {trending.map((trip) => <TripCard trip={trip} />)}
      </MarqueeTrack>

      <div class="container-page mt-14 flex justify-center">
        <a
          href="/book.html"
          class="inline-flex items-center gap-2 rounded-full border-2 border-border px-7 py-3.5 text-base font-bold text-ink transition-colors hover:border-brand hover:bg-brand"
        >
          Plan Your Trip
        </a>
      </div>
    </section>


    <!-- 2 to 3 Side Scrolling Banners (Website Theme Typography) -->
    <SideScrollingBanners />

    <!-- Popular Destination Quick Browse (16 Authentic Circles Matching Image) -->
    <DestinationCircles />

    <!-- What We Specialize In / Book with Confidence -->
    <SpecialitiesSection />

    <!-- Categories -->
    <section id="categories" class="bg-paper py-20 sm:py-28">
      <div class="container-page">
        <div data-reveal class="mb-14 flex flex-col items-center text-center">
          <span class="mb-2 text-sm font-bold uppercase tracking-[0.2em] text-ink-muted">Curated Experiences</span>
          <h2 class="text-balance font-display text-4xl text-ink sm:text-5xl lg:text-6xl">Real Experiences</h2>
        </div>
      </div>

      <MarqueeTrack>
        {categories.map((c) => <CategoryCard image={c.image} alt={c.alt} title={c.title} description={c.description} />)}
      </MarqueeTrack>
    </section>

    <!-- Why Us (Theme Harmonized Bento Grid & Trust Strip) -->
    <WhyUsSection />

    <!-- Sliding Posters (New Year Early Bird Sale & Zamna Festival Bali) -->
    <PosterSlider />


    <!-- Expert CTA -->
    <section class="py-20 sm:py-28">
      <div class="container-page">
        <div data-reveal class="relative overflow-hidden rounded-3xl">
          <img
            src="https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?q=80&w=2073&auto=format&fit=crop"
            alt="Epic Travel Destination"
            width="2073"
            height="1382"
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/85 to-ink/20"></div>

          <div class="relative max-w-xl px-8 py-20 sm:px-16 sm:py-28">
            <h2 class="font-display text-3xl leading-tight text-text-inverse sm:text-5xl lg:text-6xl">
              Not sure where your <span class="text-brand">next adventure</span> should be?
            </h2>
            <p class="mt-6 text-lg text-text-inverse-muted">
              Leave the details to us! Our experts design trips that match your energy and bring your travel dreams
              alive.
            </p>
            <a
              href={whatsappLink("Hi Century Holidays! I'm not sure where to go yet — can you suggest options?")}
              target="_blank"
              rel="noopener"
              class="mt-10 inline-flex items-center gap-2 rounded-full bg-brand px-7 py-3.5 text-base font-bold text-ink transition-transform duration-200 hover:-translate-y-0.5 hover:shadow-card-hover"
            >
              Connect with Expert <i class="ph-fill ph-whatsapp-logo" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQs -->
    <section id="faqs" class="bg-paper py-20 sm:py-28">
      <div class="container-page">
        <!-- Section Header -->
        <div data-reveal class="mb-12 sm:mb-16 flex flex-col items-center text-center">
          <div class="mb-3.5 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-1.5 shadow-xs">
            <i class="ph-fill ph-question text-base text-brand"></i>
            <span class="text-xs font-bold uppercase tracking-[0.2em] text-ink">Everything You Need To Know</span>
          </div>
          <h2 class="font-sans font-extrabold text-3xl sm:text-4xl lg:text-5xl text-ink tracking-tight">
            Frequently Asked Questions
          </h2>
          <p class="mt-3.5 max-w-xl text-base sm:text-lg text-text-muted">
            Got questions about your upcoming adventure? Here is everything you need to know about our packages, payments, and 24/7 on-trip support.
          </p>
        </div>

        <!-- Initial 10 FAQs (Starting view) -->
        <div class="mx-auto grid max-w-5xl gap-4 sm:gap-5 lg:grid-cols-2 lg:items-start">
          {initialFaqs.map((faq) => <FaqItem question={faq.question} answer={faq.answer} open={faq.open} />)}
        </div>

        <!-- Extra FAQs (Items 11-15, toggled by user) -->
        <div id="faq-extra-container" class="mx-auto mt-4 sm:mt-5 hidden max-w-5xl">
          <div class="grid gap-4 sm:gap-5 lg:grid-cols-2 lg:items-start">
            {extraFaqs.map((faq) => <FaqItem question={faq.question} answer={faq.answer} open={faq.open} />)}
          </div>
        </div>

        <!-- Show More / Less Toggle Button -->
        <div class="mt-10 sm:mt-12 flex flex-col items-center justify-center">
          <button
            type="button"
            id="faq-toggle-btn"
            class="group inline-flex items-center gap-2.5 rounded-full border-2 border-ink bg-surface px-8 py-3.5 text-sm font-bold text-ink shadow-xs transition-all duration-200 hover:bg-ink hover:text-white hover:shadow-card cursor-pointer"
            aria-expanded="false"
            aria-controls="faq-extra-container"
          >
            <span id="faq-toggle-label">View All 15 FAQs</span>
            <i id="faq-toggle-icon" class="ph-bold ph-caret-down text-base transition-transform duration-300 group-hover:translate-y-0.5" aria-hidden="true"></i>
          </button>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  function setupLiveCounters() {
    const reviewsEl = document.getElementById('counter-reviews');
    const travellersEl = document.getElementById('counter-travellers');
    if (!reviewsEl || !travellersEl) return;

    const revMin = 100;
    const revMax = 300;
    const travMin = 2000;
    const travMax = 7000;

    const scrollDuration = 3000; // 3 seconds smooth scroll
    const pauseDuration = 3500;  // 3.5 seconds pause at final numbers

    let animId = null;
    let timeoutId = null;
    let startTime = null;

    function runScroll(timestamp) {
      if (!startTime) startTime = timestamp;
      const elapsed = timestamp - startTime;
      const progress = Math.min(elapsed / scrollDuration, 1);

      // Smooth deceleration curve
      const ease = 1 - Math.pow(1 - progress, 2.2);

      const currentRev = Math.round(revMin + (revMax - revMin) * ease);
      const currentTrav = Math.round(travMin + (travMax - travMin) * ease);

      reviewsEl.textContent = String(currentRev);
      travellersEl.textContent = currentTrav.toLocaleString();

      if (progress < 1) {
        animId = requestAnimationFrame(runScroll);
      } else {
        reviewsEl.textContent = String(revMax);
        travellersEl.textContent = travMax.toLocaleString();

        timeoutId = setTimeout(() => {
          startTime = null;
          animId = requestAnimationFrame(runScroll);
        }, pauseDuration);
      }
    }

    animId = requestAnimationFrame(runScroll);

    document.addEventListener(
      'astro:before-swap',
      () => {
        if (animId) cancelAnimationFrame(animId);
        if (timeoutId) clearTimeout(timeoutId);
      },
      { once: true }
    );
  }

  function setupFaqToggle() {
    const btn = document.getElementById('faq-toggle-btn');
    const container = document.getElementById('faq-extra-container');
    const label = document.getElementById('faq-toggle-label');
    const icon = document.getElementById('faq-toggle-icon');

    if (!btn || !container || !label || !icon) return;

    btn.addEventListener('click', () => {
      const isHidden = container.classList.contains('hidden');
      if (isHidden) {
        container.classList.remove('hidden');
        label.textContent = 'Show Fewer FAQs (10)';
        icon.classList.add('rotate-180');
        btn.setAttribute('aria-expanded', 'true');
      } else {
        container.classList.add('hidden');
        label.textContent = 'View All 15 FAQs';
        icon.classList.remove('rotate-180');
        btn.setAttribute('aria-expanded', 'false');
        btn.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  }

  function initPage() {
    setupLiveCounters();
    setupFaqToggle();
  }

  initPage();
  document.addEventListener('astro:page-load', initPage);
</script>

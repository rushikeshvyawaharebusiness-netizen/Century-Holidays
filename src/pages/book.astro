---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import FormField from '../components/FormField.astro';
import { allTrips } from '../data/trips';

// Destination options mirror the packages we actually sell, so an enquiry maps to a real
// itinerary. The hero quick-picks and departures board link here with ?destination=<slug>.
const destinationOptions = [
  { value: '', label: 'Select a destination…', disabled: true, selected: true },
  ...allTrips().map((trip) => ({ value: trip.slug, label: trip.name })),
  { value: 'other-india', label: 'Somewhere else in India' },
  { value: 'other-international', label: 'Another international destination' },
  { value: 'custom', label: 'I want a fully custom trip' },
];
import { breadcrumbSchema } from '../data/schema';

/* Breadcrumb trail, so Google shows "Home > Book Your Trip" instead of a raw URL. */
const structuredData = [
  breadcrumbSchema(Astro.site, [
    { name: 'Home', path: '/' },
    { name: "Book Your Trip", path: '/book.html' },
  ]),
];
---

<BaseLayout
  path="/book.html"
  structuredData={structuredData}
>
  <main id="main-content">
    <PageHero
      tone="dark"
      title="Traveler"
      highlight="Details"
      subtitle="Tell us exactly what you need and our experts will craft the perfect seamless itinerary for you."
    />

    <section class="relative z-20 -mt-16 pb-24">
      <div class="container-page">
        <div data-reveal class="rounded-3xl border border-border bg-surface p-8 shadow-panel sm:p-16">
          <form class="flex flex-col gap-14">
            <div>
              <h2 class="mb-8 flex items-center gap-3 border-b border-border pb-4 font-display text-2xl text-ink">
                <i class="ph-fill ph-user-circle text-ink-muted" aria-hidden="true"></i> Personal Information
              </h2>
              <div class="grid gap-6 sm:grid-cols-2">
                <FormField icon="ph-user" label="Lead Traveler Full Name *" name="fullName" placeholder="e.g. John Doe" autocomplete="name" required />
                <FormField
                  icon="ph-phone"
                  label="Contact Number (WhatsApp preferred) *"
                  name="phone"
                  type="tel"
                  placeholder="+91 98765 43210"
                  autocomplete="tel"
                  required
                />
                <FormField
                  icon="ph-envelope-simple"
                  label="Email Address *"
                  name="email"
                  type="email"
                  placeholder="john@example.com"
                  autocomplete="email"
                  required
                />
                <FormField icon="ph-map-trifold" label="State *" name="state" placeholder="e.g. Maharashtra" autocomplete="address-level1" required />
                <FormField icon="ph-buildings" label="City *" name="city" placeholder="e.g. Nashik" autocomplete="address-level2" required />
              </div>
            </div>

            <div>
              <h2 class="mb-8 flex items-center gap-3 border-b border-border pb-4 font-display text-2xl text-ink">
                <i class="ph-fill ph-airplane-tilt text-ink-muted" aria-hidden="true"></i> Trip Details
              </h2>
              <div class="grid gap-6 sm:grid-cols-2">
                <FormField
                  as="select"
                  icon="ph-map-pin"
                  label="Desired Destination *"
                  name="destination"
                  required
                  options={destinationOptions}
                />
                <FormField icon="ph-calendar-blank" label="Estimated Travel Date *" name="travelDate" type="date" required />
              </div>

              <div class="mt-6 grid gap-6 sm:grid-cols-3">
                <FormField
                  as="select"
                  icon="ph-users"
                  label="Number of Adults *"
                  name="adults"
                  required
                  options={[
                    { value: '1', label: '1 Adult' },
                    { value: '2', label: '2 Adults', selected: true },
                    { value: '3', label: '3 Adults' },
                    { value: '4', label: '4 Adults' },
                    { value: '5+', label: '5+ Adults' },
                  ]}
                />
                <FormField
                  as="select"
                  icon="ph-baby"
                  label="Number of Children (0-12 yrs)"
                  name="children"
                  options={[
                    { value: '0', label: '0 Children', selected: true },
                    { value: '1', label: '1 Child' },
                    { value: '2', label: '2 Children' },
                    { value: '3+', label: '3+ Children' },
                  ]}
                />
                <FormField
                  as="select"
                  icon="ph-clock"
                  label="Duration of Trip *"
                  name="duration"
                  required
                  options={[
                    { value: '1-3', label: '1-3 Days' },
                    { value: '4-7', label: '4-7 Days', selected: true },
                    { value: '8-14', label: '8-14 Days' },
                    { value: '15+', label: '15+ Days' },
                  ]}
                />
              </div>
            </div>

            <div>
              <h2 class="mb-8 flex items-center gap-3 border-b border-border pb-4 font-display text-2xl text-ink">
                <i class="ph-fill ph-star text-ink-muted" aria-hidden="true"></i> Special Preferences
              </h2>
              <FormField
                as="textarea"
                icon="ph-chat-text"
                label="Any special requirements or celebrations? (e.g. Honeymoon, Accessibility needs, Dietary constraints)"
                name="preferences"
                placeholder="Let us know how we can make this trip extraordinary for you…"
                rows={4}
              />
            </div>

            <div class="text-center">
              <button
                type="submit"
                class="inline-flex w-full max-w-md items-center justify-center gap-2 rounded-full bg-brand px-8 py-4 text-base font-bold text-ink transition-transform duration-200 hover:-translate-y-0.5 hover:shadow-card-hover"
              >
                Submit Traveler Details <i class="ph-bold ph-paper-plane-right" aria-hidden="true"></i>
              </button>
              <p class="mt-4 text-sm text-text-muted">
                No payment is required right now. An expert will reach out to confirm your itinerary.
              </p>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <script>
    // Pre-select the package a traveller arrived from (?destination=<slug>), so the
    // quick-picks and departures board carry their choice into the form.
    const slug = new URLSearchParams(window.location.search).get('destination');
    const select = document.querySelector<HTMLSelectElement>('select[name="destination"]');

    if (slug && select && [...select.options].some((option) => option.value === slug)) {
      select.value = slug;
    }
  </script>
</BaseLayout>

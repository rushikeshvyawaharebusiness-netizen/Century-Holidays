---
import { Image } from 'astro:assets';
import bgCoast from '../assets/images/poster-coast.jpg';
import bgZamna from '../assets/images/poster-zamna.jpg';
import imgAlmaty from '../assets/images/poster-almaty.jpg';
import imgBali from '../assets/images/card-bali.jpg';
import imgSriLanka from '../assets/images/card-srilanka.jpg';
import { whatsappLink } from '../data/contact';
---

<section class="py-12 sm:py-16 bg-paper overflow-hidden" aria-label="Special Offers and Festival Trips">
  <div class="container-page max-w-7xl">
    {/* Slider Wrapper */}
    <div class="relative group/slider" id="poster-slider-container">
      {/* Slides Viewport */}
      <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl shadow-md bg-ink">
        <div
          id="poster-slides-track"
          class="flex transition-transform duration-700 ease-in-out"
          style="transform: translateX(0%);"
        >
          {/* SLIDE 1: New Year Early Bird Sale */}
          <div class="w-full shrink-0 relative min-h-[240px] sm:min-h-[290px] md:min-h-[320px] lg:min-h-[340px] flex items-center overflow-hidden">
            {/* Background Image with Ambient Darkness */}
            <Image
              src={bgCoast}
              alt="Aerial Tropical Coastline Road"
              class="absolute inset-0 h-full w-full object-cover object-center"
              width={768}
              widths={[768, 1280, 1920]}
              sizes="100vw"
              quality={90}
            />
            {/* Subtle Gradient Overlays */}
            <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/55 to-black/35"></div>
            <div class="absolute inset-0 bg-radial-at-c from-transparent via-transparent to-black/40"></div>

            {/* Corner "SALE" Ribbon */}
            <div class="absolute top-0 right-0 overflow-hidden w-28 h-28 sm:w-36 sm:h-36 pointer-events-none z-20">
              <div class="absolute top-5 sm:top-7 -right-9 sm:-right-10 w-36 sm:w-44 py-1 sm:py-1.5 bg-[#E50914] text-white text-center font-black tracking-widest text-xs sm:text-sm uppercase rotate-45 shadow-md">
                SALE
              </div>
            </div>

            {/* Slide 1 Content */}
            <div class="relative z-10 w-full px-6 py-8 sm:px-10 sm:py-12 lg:px-14 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 sm:gap-8">
              {/* Left Column: SALE Heading & CTA */}
              <div class="max-w-xl">
                <span class="block font-sans text-xl sm:text-2xl lg:text-3xl font-medium text-white/95 tracking-tight">
                  New Year
                </span>
                <h3 class="font-sans text-3xl sm:text-5xl lg:text-6xl font-black text-white leading-none tracking-tight mt-1 sm:mt-1.5">
                  EARLY BIRD <br />
                  SALE
                </h3>

                {/* Offer Pill with Dashed Outline */}
                <div class="mt-4 sm:mt-6 inline-flex items-center gap-2 rounded-full border-2 border-dashed border-white/80 bg-black/30 backdrop-blur-xs p-1 sm:p-1.5 pr-2">
                  <span class="pl-2 sm:pl-3 font-sans text-sm sm:text-lg font-bold text-white">
                    Get
                  </span>
                  <a
                    href={whatsappLink("Hi Century Holidays! I want to claim the New Year Early Bird ₹10,000/- discount.")}
                    target="_blank"
                    rel="noopener"
                    class="rounded-full bg-[#E50914] px-3.5 py-1 sm:px-5 sm:py-1.5 text-sm sm:text-lg font-black text-white shadow-sm transition-transform duration-200 hover:scale-105"
                  >
                    ₹10,000/- Off
                  </a>
                </div>
              </div>

              {/* Right Column: 3 Polaroid Destination Cards with Map Pins */}
              <div class="hidden sm:flex items-center gap-3 md:gap-4 lg:gap-5 self-center shrink-0 pr-6 sm:pr-8 md:pr-10">
                {/* 1. Almaty */}
                <div class="flex flex-col items-center group/card">
                  <div class="flex items-center gap-1 text-white text-xs font-bold mb-1">
                    <i class="ph-fill ph-map-pin text-white text-sm drop-shadow" aria-hidden="true"></i>
                  </div>
                  <div class="h-20 w-20 md:h-24 md:w-24 lg:h-28 lg:w-28 rounded-xl overflow-hidden border-2 border-dashed border-white/90 shadow-md transition-transform duration-300 group-hover/card:scale-108">
                    <Image
                      src={imgAlmaty}
                      alt="Almaty Ascension Cathedral"
                      class="h-full w-full object-cover object-center"
                      width={120}
                      widths={[120, 240]}
                      sizes="(min-width: 1024px) 112px, (min-width: 768px) 96px, 80px"
                      quality={85}
                    />
                  </div>
                  <span class="mt-1.5 font-sans text-xs sm:text-sm font-bold text-white drop-shadow-md">
                    Almaty
                  </span>
                </div>

                {/* 2. Bali */}
                <div class="flex flex-col items-center group/card">
                  <div class="flex items-center gap-1 text-white text-xs font-bold mb-1">
                    <i class="ph-fill ph-map-pin text-white text-sm drop-shadow" aria-hidden="true"></i>
                  </div>
                  <div class="h-20 w-20 md:h-24 md:w-24 lg:h-28 lg:w-28 rounded-xl overflow-hidden border-2 border-dashed border-white/90 shadow-md transition-transform duration-300 group-hover/card:scale-108">
                    <Image
                      src={imgBali}
                      alt="Bali Kelingking Beach"
                      class="h-full w-full object-cover object-center"
                      width={120}
                      widths={[120, 240]}
                      sizes="(min-width: 1024px) 112px, (min-width: 768px) 96px, 80px"
                      quality={85}
                    />
                  </div>
                  <span class="mt-1.5 font-sans text-xs sm:text-sm font-bold text-white drop-shadow-md">
                    Bali
                  </span>
                </div>

                {/* 3. Sri Lanka */}
                <div class="flex flex-col items-center group/card">
                  <div class="flex items-center gap-1 text-white text-xs font-bold mb-1">
                    <i class="ph-fill ph-map-pin text-white text-sm drop-shadow" aria-hidden="true"></i>
                  </div>
                  <div class="h-20 w-20 md:h-24 md:w-24 lg:h-28 lg:w-28 rounded-xl overflow-hidden border-2 border-dashed border-white/90 shadow-md transition-transform duration-300 group-hover/card:scale-108">
                    <Image
                      src={imgSriLanka}
                      alt="Sri Lanka Nine Arch Bridge Train"
                      class="h-full w-full object-cover object-center"
                      width={120}
                      widths={[120, 240]}
                      sizes="(min-width: 1024px) 112px, (min-width: 768px) 96px, 80px"
                      quality={85}
                    />
                  </div>
                  <span class="mt-1.5 font-sans text-xs sm:text-sm font-bold text-white drop-shadow-md">
                    Sri Lanka
                  </span>
                </div>
              </div>
            </div>
          </div>

          {/* SLIDE 2: ZAMNA FESTIVAL BALI */}
          <div class="w-full shrink-0 relative min-h-[240px] sm:min-h-[290px] md:min-h-[320px] lg:min-h-[340px] flex items-center overflow-hidden">
            {/* Background Image */}
            <Image
              src={bgZamna}
              alt="Zamna Festival Bali Music Stage"
              class="absolute inset-0 h-full w-full object-cover object-center"
              width={768}
              widths={[768, 1280, 1920]}
              sizes="100vw"
              quality={90}
            />
            {/* Gradient Darkening Overlay */}
            <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-black/35"></div>

            {/* Slide 2 Content */}
            <div class="relative z-10 w-full px-6 py-8 sm:px-10 sm:py-12 lg:px-14 flex items-center justify-between gap-6">
              {/* Left Column: Festival Typography & Pill */}
              <div class="max-w-lg">
                <h3 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-[0.12em] uppercase leading-tight">
                  ZAMNA <br />
                  FESTIVAL
                </h3>

                <div class="mt-4 sm:mt-6">
                  <a
                    href={whatsappLink("Hi Century Holidays! I want to enquire about the Zamna Festival Bali package.")}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex items-center gap-2 rounded-full border border-white/80 bg-black/40 backdrop-blur-xs px-5 py-2 text-sm sm:text-base font-semibold text-white transition-all duration-200 hover:bg-white hover:text-ink hover:border-white shadow-sm"
                  >
                    Package Starting from <span class="font-bold text-brand">₹58,999/-</span>
                  </a>
                </div>
              </div>

              {/* Right Column: Giant Luxury Serif "BALI" */}
              <div class="hidden sm:block select-none pointer-events-none pr-4 sm:pr-8 lg:pr-12 shrink-0">
                <span class="font-display font-black text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-9xl text-[#FDF8EC] tracking-wider drop-shadow-lg opacity-95">
                  BALI
                </span>
              </div>
            </div>
          </div>
        </div>

        {/* Carousel Navigation Arrows */}
        <button
          type="button"
          id="poster-prev-btn"
          aria-label="Previous Slide"
          class="absolute left-3 sm:left-5 top-1/2 -translate-y-1/2 hidden lg:flex h-9 w-9 sm:h-11 sm:w-11 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur-xs border border-white/20 transition-all duration-200 hover:bg-white hover:text-ink shadow-md cursor-pointer"
        >
          <i class="ph-bold ph-caret-left text-lg sm:text-xl" aria-hidden="true"></i>
        </button>
        <button
          type="button"
          id="poster-next-btn"
          aria-label="Next Slide"
          class="absolute right-3 sm:right-5 top-1/2 -translate-y-1/2 hidden lg:flex h-9 w-9 sm:h-11 sm:w-11 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur-xs border border-white/20 transition-all duration-200 hover:bg-white hover:text-ink shadow-md cursor-pointer"
        >
          <i class="ph-bold ph-caret-right text-lg sm:text-xl" aria-hidden="true"></i>
        </button>

        {/* Indicator Dots */}
        <div class="absolute bottom-3 sm:bottom-4 left-1/2 -translate-x-1/2 flex items-center gap-2 z-20">
          <button
            type="button"
            class="poster-dot h-2 w-7 rounded-full bg-white transition-all duration-300 cursor-pointer"
            data-index="0"
            aria-label="Go to Slide 1"
          ></button>
          <button
            type="button"
            class="poster-dot h-2 w-2 rounded-full bg-white/40 transition-all duration-300 cursor-pointer"
            data-index="1"
            aria-label="Go to Slide 2"
          ></button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Same reasoning as the banner carousel: these 8px dots are the touch control now that
     the arrows only show from lg up. Grow the hit area to 32px without moving the dot.
     Kept tighter than the banner dots because this row sits inside the slide, so a taller
     target would start swallowing taps meant for the slide content above it. */
  .poster-dot {
    position: relative;
  }
  .poster-dot::before {
    content: '';
    position: absolute;
    inset: -12px -4px;
  }
</style>

<script>
  function initPosterSlider() {
    const track = document.getElementById('poster-slides-track');
    const dots = document.querySelectorAll('.poster-dot');
    const prevBtn = document.getElementById('poster-prev-btn');
    const nextBtn = document.getElementById('poster-next-btn');
    const container = document.getElementById('poster-slider-container');

    if (!track || dots.length === 0) return;

    let currentIndex = 0;
    const totalSlides = dots.length;
    let autoTimer = null;

    function goToSlide(index) {
      currentIndex = (index + totalSlides) % totalSlides;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      dots.forEach((d, i) => {
        if (i === currentIndex) {
          d.classList.remove('w-2', 'bg-white/40');
          d.classList.add('w-7', 'bg-white');
        } else {
          d.classList.remove('w-7', 'bg-white');
          d.classList.add('w-2', 'bg-white/40');
        }
      });
    }

    function startAuto() {
      stopAuto();
      autoTimer = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 5500);
    }

    function stopAuto() {
      if (autoTimer) clearInterval(autoTimer);
    }

    prevBtn?.addEventListener('click', () => {
      goToSlide(currentIndex - 1);
      startAuto();
    });

    nextBtn?.addEventListener('click', () => {
      goToSlide(currentIndex + 1);
      startAuto();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
        goToSlide(idx);
        startAuto();
      });
    });

    container?.addEventListener('mouseenter', stopAuto);
    container?.addEventListener('mouseleave', startAuto);

    // Touch swipe: the prev/next arrows are hidden under sm because they sat on top of the
    // slide headline, so swipe is how touch users move between slides (the dots still work).
    let touchStartX = 0;

    container?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAuto();
    }, { passive: true });

    container?.addEventListener('touchend', (e) => {
      const diff = touchStartX - e.changedTouches[0].screenX;
      if (Math.abs(diff) > 40) goToSlide(currentIndex + (diff > 0 ? 1 : -1));
      startAuto();
    }, { passive: true });

    startAuto();
  }

  initPosterSlider();
  document.addEventListener('astro:page-load', initPosterSlider);
</script>


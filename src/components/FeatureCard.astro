---
interface Props {
  icon: string;
  title: string;
  description: string;
  index?: number;
}

const { icon, title, description, index = 0 } = Astro.props;
const delayMs = index * 120;
---

<div
  data-reveal
  style={`transition-delay: ${delayMs}ms;`}
  class="feature-card flex flex-col items-start gap-5 rounded-2xl border border-border bg-surface p-8 shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-card-hover"
>
  <div class="feature-icon grid h-14 w-14 shrink-0 place-items-center rounded-full bg-surface-muted text-2xl text-ink transition-colors duration-500">
    <i class={icon} aria-hidden="true"></i>
  </div>
  <div>
    <h3 class="mb-2 font-display text-xl text-ink">{title}</h3>
    <p class="leading-relaxed text-text-muted">{description}</p>
  </div>
</div>

<style>
  :global(.js) .is-visible.feature-card .feature-icon {
    background-color: var(--color-brand);
    color: var(--color-ink);
  }
</style>

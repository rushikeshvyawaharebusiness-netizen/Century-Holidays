---
// TravelerPopupModal.astro
// Styled to match the exact user-provided reference design
// Clean white rounded card, pill inputs, "+91 Enter mobile number", and "Talk to our Experts" green button
---

<div
  id="traveler-popup-overlay"
  class="fixed inset-0 flex items-center justify-center p-4 sm:p-6 opacity-0 pointer-events-none transition-opacity duration-300 ease-out"
  style="z-index: 9999;"
  role="dialog"
  aria-modal="true"
  aria-labelledby="popup-title"
>
  <!-- Dark Backdrop -->
  <div id="traveler-popup-backdrop" class="fixed inset-0 bg-black/60 transition-opacity duration-300"></div>

  <!-- Modal Container (White rounded card matching reference) -->
  <div
    id="traveler-popup-card"
    class="relative w-full max-w-[420px] scale-95 rounded-[26px] bg-white p-6 sm:p-7 shadow-2xl transition-all duration-300 ease-out overflow-hidden"
  >
    <!-- Close Button (Light circular ring matching reference) -->
    <button
      type="button"
      id="traveler-popup-close"
      class="absolute top-5 right-5 z-20 grid h-8 w-8 place-items-center rounded-full border border-gray-200 bg-gray-50 text-gray-500 hover:bg-gray-100 hover:text-gray-800 transition-colors duration-150 cursor-pointer"
      aria-label="Close dialog"
    >
      <i class="ph-bold ph-x text-sm" aria-hidden="true"></i>
    </button>

    <!-- Header -->
    <div class="pr-8">
      <h3 id="popup-title" class="text-xl sm:text-[22px] font-bold text-gray-900 leading-tight">
        Let's plan your dream trip!
      </h3>
      <p class="mt-1.5 text-xs sm:text-[13px] text-gray-500 leading-relaxed">
        Drop a few details, and we'll craft an unforgettable adventure just for you!
      </p>
    </div>

    <!-- Form Body (Pill-shaped inputs matching reference) -->
    <div class="mt-5">
      <form id="traveler-popup-form" class="flex flex-col gap-3">
        <!-- Name Field -->
        <div>
          <input
            type="text"
            id="popup-input-name"
            name="travelerName"
            required
            placeholder="Name"
            autocomplete="name"
            class="w-full rounded-full border border-gray-300 bg-white px-5 py-2.5 sm:py-3 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:border-gray-600 transition-colors"
          />
        </div>

        <!-- Destination Field -->
        <div>
          <input
            type="text"
            id="popup-input-dest"
            name="destination"
            list="popup-dest-suggestions"
            required
            placeholder="Choose your destination..."
            autocomplete="off"
            class="w-full rounded-full border border-gray-300 bg-white px-5 py-2.5 sm:py-3 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:border-gray-600 transition-colors"
          />
          <datalist id="popup-dest-suggestions">
            <option value="Bali, Indonesia"></option>
            <option value="Thailand (Phuket & Krabi)"></option>
            <option value="Vietnam & Ha Long Bay"></option>
            <option value="Paris, France"></option>
            <option value="Dubai, UAE"></option>
            <option value="Himachal (Manali & Kasol)"></option>
            <option value="Spiti Valley Expedition"></option>
            <option value="Meghalaya & North East"></option>
            <option value="Ladakh High-Pass Tour"></option>
            <option value="Kerala Backwaters"></option>
            <option value="Kedarnath / Do Dham"></option>
            <option value="Sri Lanka"></option>
            <option value="Bhutan"></option>
          </datalist>
        </div>

        <!-- Phone Field with +91 -->
        <div class="flex items-center rounded-full border border-gray-300 bg-white px-5 py-0 focus-within:border-gray-600 transition-colors">
          <span class="text-sm font-medium text-gray-600 select-none mr-3">+91</span>
          <input
            type="tel"
            id="popup-input-phone"
            name="travelerPhone"
            required
            placeholder="Enter mobile number"
            autocomplete="tel"
            class="w-full py-2.5 sm:py-3 text-sm text-gray-900 placeholder:text-gray-400 bg-transparent focus:outline-none"
          />
        </div>

        <!-- Email Field -->
        <div>
          <input
            type="email"
            id="popup-input-email"
            name="travelerEmail"
            required
            placeholder="Email"
            autocomplete="email"
            class="w-full rounded-full border border-gray-300 bg-white px-5 py-2.5 sm:py-3 text-sm text-gray-900 placeholder:text-gray-400 focus:outline-none focus:border-gray-600 transition-colors"
          />
        </div>

        <!-- Submit Button (Green pill matching reference) -->
        <button
          type="submit"
          class="mt-1 inline-flex w-full items-center justify-center rounded-full bg-[#038749] py-3 sm:py-3.5 px-6 text-sm sm:text-base font-bold text-white transition-colors hover:bg-[#02743e] cursor-pointer shadow-xs"
        >
          Talk to our Experts
        </button>
      </form>

      <!-- Success State -->
      <div id="traveler-popup-success" class="hidden py-6 text-center">
        <div class="mx-auto mb-3 grid h-12 w-12 place-items-center rounded-full bg-[#038749] text-white text-xl font-bold">
          <i class="ph-bold ph-check" aria-hidden="true"></i>
        </div>
        <h4 class="text-xl font-bold text-gray-900">
          Thank you, <span id="popup-success-name">Traveler</span>!
        </h4>
        <p class="mt-2 text-xs sm:text-sm text-gray-500 max-w-xs mx-auto leading-relaxed">
          Our travel specialist has received your details and will contact you on WhatsApp shortly.
        </p>
        <button
          type="button"
          id="popup-success-close-btn"
          class="mt-5 inline-flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 px-6 py-2.5 text-xs sm:text-sm font-semibold text-gray-800 transition-colors cursor-pointer"
        >
          Close
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function initTravelerPopup() {
    const overlay = document.getElementById('traveler-popup-overlay');
    const card = document.getElementById('traveler-popup-card');
    const backdrop = document.getElementById('traveler-popup-backdrop');
    const closeBtn = document.getElementById('traveler-popup-close');
    const form = document.getElementById('traveler-popup-form') as HTMLFormElement | null;
    const successView = document.getElementById('traveler-popup-success');
    const successCloseBtn = document.getElementById('popup-success-close-btn');
    const successName = document.getElementById('popup-success-name');

    if (!overlay || !card) return;

    // Show on homepage ('/' or '/index.html')
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    const isHomePage = currentPath === '/' || currentPath.endsWith('index.html');
    if (!isHomePage) return;

    // Reset form state in case of view-transition / re-init
    if (form && successView) {
      form.classList.remove('hidden');
      successView.classList.add('hidden');
    }

    function openPopup() {
      if (!overlay || !card) return;
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100', 'pointer-events-auto');
      card.classList.remove('scale-95');
      card.classList.add('scale-100');
      document.body.classList.add('overflow-hidden');
    }

    function closePopup() {
      if (!overlay || !card) return;
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      overlay.classList.add('opacity-0', 'pointer-events-none');
      card.classList.remove('scale-100');
      card.classList.add('scale-95');
      document.body.classList.remove('overflow-hidden');
    }

    // Trigger popup promptly on homepage refresh / load
    const timer = setTimeout(() => {
      openPopup();
    }, 800);

    // Close listeners
    closeBtn?.addEventListener('click', () => {
      clearTimeout(timer);
      closePopup();
    });

    backdrop?.addEventListener('click', () => {
      clearTimeout(timer);
      closePopup();
    });

    successCloseBtn?.addEventListener('click', () => {
      closePopup();
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay.classList.contains('opacity-100')) {
        closePopup();
      }
    });

    // Handle Form Submit
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const name = (formData.get('travelerName')) || 'Traveler';

      // Switch to success view
      if (successName) successName.textContent = typeof name === 'string' ? (name.split(' ')[0] || 'Traveler') : 'Traveler';
      form.classList.add('hidden');
      successView?.classList.remove('hidden');

      // Auto-close after 2.5 seconds
      setTimeout(() => {
        closePopup();
      }, 2500);
    });
  }

  // Run on load and View Transitions
  initTravelerPopup();
  document.addEventListener('astro:page-load', initTravelerPopup);
</script>

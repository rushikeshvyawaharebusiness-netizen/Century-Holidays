---
// DestinationCircles.astro
// "Where to Next? - Quick Destination Explorer"
// 100% Theme Harmonized: #F0EA1B Brand Yellow, #15140F Dark Ink, Fraunces Display Serif, Outfit Sans
import { Image } from 'astro:assets';

// 16 Authentic Real Travel Photographs (0% AI)
import imgSriLanka from '../assets/images/card-srilanka.jpg';
import imgVietnam from '../assets/images/card-vietnam.jpg';
import imgBali from '../assets/images/card-bali.jpg';
import imgThailand from '../assets/images/card-thailand-hd.jpg';
import imgParis from '../assets/images/card-paris.jpg';
import imgBhutan from '../assets/images/card-bhutan.jpg';
import imgJapan from '../assets/images/circle-japan.jpg';
import imgNepal from '../assets/images/circle-nepal.jpg';

import imgMeghalaya from '../assets/images/circle-meghalaya.jpg';
import imgSpiti from '../assets/images/circle-spiti.jpg';
import imgLadakh from '../assets/images/circle-ladakh.jpg';
import imgTawang from '../assets/images/circle-tawang.jpg';
import imgAndaman from '../assets/images/circle-andaman.jpg';
import imgHimachal from '../assets/images/speciality-mountains.jpg';
import imgManali from '../assets/images/circle-manali.jpg';
import imgKerala from '../assets/images/circle-kerala.jpg';

const international = [
  { name: 'Sri Lanka', tag: 'Tropical Coast', image: imgSriLanka, link: '#destinations' },
  { name: 'Vietnam', tag: 'Heritage & Bays', image: imgVietnam, link: '#destinations' },
  { name: 'Bali', tag: 'Island Paradise', image: imgBali, link: '#destinations' },
  { name: 'Thailand', tag: 'Islands & Culture', image: imgThailand, link: '#destinations' },
  { name: 'Paris', tag: 'Romance & Arts', image: imgParis, link: '#destinations' },
  { name: 'Bhutan', tag: 'Himalayan Kingdom', image: imgBhutan, link: '#destinations' },
  { name: 'Japan', tag: 'Cherry Blossom', image: imgJapan, link: '#destinations' },
  { name: 'Nepal', tag: 'Treks & Temples', image: imgNepal, link: '#destinations' },
];

const domestic = [
  { name: 'Meghalaya', tag: 'Living Root Bridges', image: imgMeghalaya, link: '#destinations' },
  { name: 'Spiti Valley', tag: 'Cold Desert Safari', image: imgSpiti, link: '#destinations' },
  { name: 'Ladakh', tag: 'High-Pass Expedition', image: imgLadakh, link: '#destinations' },
  { name: 'Tawang', tag: 'Monasteries & Lakes', image: imgTawang, link: '#destinations' },
  { name: 'Andaman', tag: 'Coral Beaches', image: imgAndaman, link: '#destinations' },
  { name: 'Himachal', tag: 'Pine & Snow Valleys', image: imgHimachal, link: '#destinations' },
  { name: 'Manali', tag: 'Mountain Trails', image: imgManali, link: '#destinations' },
  { name: 'Kerala', tag: 'Backwaters & Tea', image: imgKerala, link: '#destinations' },
];
---

<section
  id="explore-quick-destinations"
  class="relative overflow-hidden border-t border-border bg-surface py-16 sm:py-24"
  aria-label="Explore Destinations Quick Browse"
>
  {/* Subtle Brand Glow Accents */}
  <div class="pointer-events-none absolute -left-20 top-1/3 -translate-y-1/2 h-72 w-72 rounded-full bg-brand/10 blur-[100px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-20 top-2/3 -translate-y-1/2 h-72 w-72 rounded-full bg-brand/10 blur-[100px]" aria-hidden="true"></div>

  <div class="container-page relative z-10">
    {/* Section Editorial Header */}
    <div data-reveal class="mx-auto mb-10 sm:mb-14 max-w-2xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface-muted px-4 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-ink shadow-2xs">
        <i class="ph-fill ph-compass text-brand text-sm" aria-hidden="true"></i>
        <span>Popular Destinations</span>
      </span>
      <h2 class="mt-3.5 font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-ink tracking-tight text-balance">
        Where to Next?
      </h2>
      <p class="mt-3 text-base sm:text-lg text-text-muted leading-relaxed">
        Pick your dream escape from our handpicked international getaways and majestic Indian expeditions.
      </p>

      {/* Interactive Category Filter Pills */}
      <div class="mt-7 sm:mt-8 flex flex-wrap items-center justify-center gap-2 sm:gap-3" id="circle-filter-tabs">
        <button
          type="button"
          class="circle-filter-pill active inline-flex items-center gap-1.5 rounded-full px-5 py-2 text-xs sm:text-sm font-bold transition-all duration-200 bg-brand text-ink shadow-sm cursor-pointer"
          data-circle-filter="all"
        >
          <span>All Destinations</span>
          <span class="grid h-5 w-5 place-items-center rounded-full bg-ink/10 text-[11px] font-extrabold">16</span>
        </button>
        <button
          type="button"
          class="circle-filter-pill inline-flex items-center gap-1.5 rounded-full border border-border bg-surface-muted px-5 py-2 text-xs sm:text-sm font-bold transition-all duration-200 text-ink-muted hover:bg-border hover:text-ink cursor-pointer"
          data-circle-filter="international"
        >
          <span>✈️ International</span>
          <span class="grid h-5 w-5 place-items-center rounded-full bg-ink/10 text-[11px] font-extrabold">8</span>
        </button>
        <button
          type="button"
          class="circle-filter-pill inline-flex items-center gap-1.5 rounded-full border border-border bg-surface-muted px-5 py-2 text-xs sm:text-sm font-bold transition-all duration-200 text-ink-muted hover:bg-border hover:text-ink cursor-pointer"
          data-circle-filter="domestic"
        >
          <span>🏔️ Domestic India</span>
          <span class="grid h-5 w-5 place-items-center rounded-full bg-ink/10 text-[11px] font-extrabold">8</span>
        </button>
      </div>
    </div>

    {/* Section 1: International Escapes */}
    <div data-reveal class="circle-dest-section mb-12 sm:mb-14" data-category="international">
      <div class="mb-5 sm:mb-6 flex items-center justify-between border-b border-border/60 pb-3">
        <div class="flex items-center gap-2.5">
          <span class="grid h-8 w-8 place-items-center rounded-full bg-brand/20 text-ink text-sm font-bold">
            ✈️
          </span>
          <div>
            <h3 class="font-sans text-base sm:text-lg font-bold text-ink tracking-tight">
              International Escapes
            </h3>
            <span class="text-xs font-semibold text-text-muted">
              Visa assistance &amp; curated holiday packages
            </span>
          </div>
        </div>

        {/* Mobile Swipe Hint */}
        <span class="sm:hidden text-[11px] font-bold text-text-muted flex items-center gap-1">
          Swipe <i class="ph-bold ph-caret-right" aria-hidden="true"></i>
        </span>
      </div>

      {/* Grid on tablet/desktop, smooth swipeable on mobile */}
      <div class="relative">
        <div class="flex sm:grid sm:grid-cols-4 md:grid-cols-8 gap-4 sm:gap-4 md:gap-3 lg:gap-4 xl:gap-5 overflow-x-auto sm:overflow-visible pb-4 sm:pb-0 scrollbar-none snap-x snap-mandatory justify-start sm:justify-items-center -mx-4 px-4 sm:mx-0 sm:px-0">
          {international.map((item) => (
            <a
              href={item.link}
              class="group flex flex-col items-center gap-2.5 shrink-0 snap-start focus-visible:outline-none transition-transform duration-300 hover:-translate-y-1.5"
              aria-label={`Explore ${item.name} travel packages`}
            >
              {/* Elevated Circular Frame with Brand Halo on Hover */}
              <div class="relative h-24 w-24 sm:h-28 sm:w-28 md:h-26 md:w-26 lg:h-28 lg:w-28 xl:h-32 xl:w-32 rounded-full p-1 border-2 border-border/90 bg-surface shadow-xs transition-all duration-300 group-hover:border-brand group-hover:shadow-card-hover group-hover:ring-4 group-hover:ring-brand/25">
                <div class="relative h-full w-full overflow-hidden rounded-full">
                  <Image
                    src={item.image}
                    alt={item.name}
                    class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-115"
                    widths={[160, 240, 320]}
                    sizes="(min-width: 1280px) 128px, (min-width: 1024px) 112px, (min-width: 768px) 104px, 96px"
                    quality={92}
                  />
                  {/* Bottom Vignette */}
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-60 group-hover:opacity-20 transition-opacity" aria-hidden="true"></div>
                </div>
              </div>

              {/* Destination Details */}
              <div class="flex flex-col items-center text-center">
                <span class="font-sans text-xs sm:text-sm font-bold text-ink tracking-tight group-hover:text-ink transition-colors leading-tight">
                  {item.name}
                </span>
                <span class="mt-0.5 font-sans text-[10px] sm:text-[11px] font-semibold text-text-muted leading-tight max-w-[100px] sm:max-w-[110px] truncate">
                  {item.tag}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>

    {/* Section 2: Domestic & Himalayan Adventures */}
    <div data-reveal class="circle-dest-section" data-category="domestic">
      <div class="mb-5 sm:mb-6 flex items-center justify-between border-b border-border/60 pb-3">
        <div class="flex items-center gap-2.5">
          <span class="grid h-8 w-8 place-items-center rounded-full bg-brand/20 text-ink text-sm font-bold">
            🏔️
          </span>
          <div>
            <h3 class="font-sans text-base sm:text-lg font-bold text-ink tracking-tight">
              Domestic &amp; Himalayan Adventures
            </h3>
            <span class="text-xs font-semibold text-text-muted">
              Road expeditions, mountain treks &amp; retreats
            </span>
          </div>
        </div>

        {/* Mobile Swipe Hint */}
        <span class="sm:hidden text-[11px] font-bold text-text-muted flex items-center gap-1">
          Swipe <i class="ph-bold ph-caret-right" aria-hidden="true"></i>
        </span>
      </div>

      {/* Grid on tablet/desktop, smooth swipeable on mobile */}
      <div class="relative">
        <div class="flex sm:grid sm:grid-cols-4 md:grid-cols-8 gap-4 sm:gap-4 md:gap-3 lg:gap-4 xl:gap-5 overflow-x-auto sm:overflow-visible pb-4 sm:pb-0 scrollbar-none snap-x snap-mandatory justify-start sm:justify-items-center -mx-4 px-4 sm:mx-0 sm:px-0">
          {domestic.map((item) => (
            <a
              href={item.link}
              class="group flex flex-col items-center gap-2.5 shrink-0 snap-start focus-visible:outline-none transition-transform duration-300 hover:-translate-y-1.5"
              aria-label={`Explore ${item.name} travel packages`}
            >
              {/* Elevated Circular Frame with Brand Halo on Hover */}
              <div class="relative h-24 w-24 sm:h-28 sm:w-28 md:h-26 md:w-26 lg:h-28 lg:w-28 xl:h-32 xl:w-32 rounded-full p-1 border-2 border-border/90 bg-surface shadow-xs transition-all duration-300 group-hover:border-brand group-hover:shadow-card-hover group-hover:ring-4 group-hover:ring-brand/25">
                <div class="relative h-full w-full overflow-hidden rounded-full">
                  <Image
                    src={item.image}
                    alt={item.name}
                    class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-115"
                    widths={[160, 240, 320]}
                    sizes="(min-width: 1280px) 128px, (min-width: 1024px) 112px, (min-width: 768px) 104px, 96px"
                    quality={92}
                  />
                  {/* Bottom Vignette */}
                  <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-60 group-hover:opacity-20 transition-opacity" aria-hidden="true"></div>
                </div>
              </div>

              {/* Destination Details */}
              <div class="flex flex-col items-center text-center">
                <span class="font-sans text-xs sm:text-sm font-bold text-ink tracking-tight group-hover:text-ink transition-colors leading-tight">
                  {item.name}
                </span>
                <span class="mt-0.5 font-sans text-[10px] sm:text-[11px] font-semibold text-text-muted leading-tight max-w-[100px] sm:max-w-[110px] truncate">
                  {item.tag}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Completely hide native scrollbar while retaining smooth touch scrolling */
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function initCircleFilters() {
    const pills = document.querySelectorAll<HTMLButtonElement>('.circle-filter-pill');
    const sections = document.querySelectorAll<HTMLElement>('.circle-dest-section');

    if (!pills.length || !sections.length) return;

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const filter = pill.getAttribute('data-circle-filter');

        pills.forEach((p) => {
          p.classList.remove('active', 'bg-brand', 'text-ink', 'shadow-sm');
          p.classList.add('border', 'border-border', 'bg-surface-muted', 'text-ink-muted');
        });

        pill.classList.add('active', 'bg-brand', 'text-ink', 'shadow-sm');
        pill.classList.remove('border', 'border-border', 'bg-surface-muted', 'text-ink-muted');

        sections.forEach((sec) => {
          const cat = sec.getAttribute('data-category');
          if (filter === 'all' || filter === cat) {
            sec.style.display = 'block';
          } else {
            sec.style.display = 'none';
          }
        });
      });
    });
  }

  initCircleFilters();
  document.addEventListener('astro:page-load', initCircleFilters);
</script>

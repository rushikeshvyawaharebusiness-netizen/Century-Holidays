---
// DestinationCircles.astro
// Authentic circular destination browsing matching user's reference (Capture A Trip style)
// Zero AI-generated headers or tags — pure, clean photography with destination names
import { Image } from 'astro:assets';

// 16 Authentic Real Travel Photographs (0% AI)
import imgSriLanka from '../assets/images/card-srilanka.jpg';
import imgVietnam from '../assets/images/card-vietnam.jpg';
import imgBali from '../assets/images/card-bali.jpg';
import imgThailand from '../assets/images/card-thailand-hd.jpg';
import imgEurope from '../assets/images/circle-europe.jpg';
import imgBhutan from '../assets/images/card-bhutan.jpg';
import imgJapan from '../assets/images/circle-japan.jpg';
import imgNepal from '../assets/images/circle-nepal.jpg';

import imgMeghalaya from '../assets/images/circle-meghalaya.jpg';
import imgSpiti from '../assets/images/circle-spiti.jpg';
import imgLadakh from '../assets/images/circle-ladakh.jpg';
import imgTawang from '../assets/images/circle-tawang.jpg';
import imgAndaman from '../assets/images/circle-andaman.jpg';
import imgHimachal from '../assets/images/speciality-mountains.jpg';
import imgManali from '../assets/images/circle-manali.jpg';
import imgKerala from '../assets/images/circle-kerala.jpg';

const row1 = [
  { name: 'Sri Lanka', image: imgSriLanka, link: '#destinations' },
  { name: 'Vietnam', image: imgVietnam, link: '#destinations' },
  { name: 'Bali', image: imgBali, link: '#destinations' },
  { name: 'Thailand', image: imgThailand, link: '#destinations' },
  { name: 'Europe', image: imgEurope, link: '#destinations' },
  { name: 'Bhutan', image: imgBhutan, link: '#destinations' },
  { name: 'Japan', image: imgJapan, link: '#destinations' },
  { name: 'Nepal', image: imgNepal, link: '#destinations' },
];

const row2 = [
  { name: 'Meghalaya', image: imgMeghalaya, link: '#destinations' },
  { name: 'Spiti Valley', image: imgSpiti, link: '#destinations' },
  { name: 'Ladakh', image: imgLadakh, link: '#destinations' },
  { name: 'Tawang', image: imgTawang, link: '#destinations' },
  { name: 'Andaman', image: imgAndaman, link: '#destinations' },
  { name: 'Himachal Pradesh', image: imgHimachal, link: '#destinations' },
  { name: 'Manali', image: imgManali, link: '#destinations' },
  { name: 'Kerala', image: imgKerala, link: '#destinations' },
];
---

<section
  id="explore-quick-destinations"
  class="relative overflow-hidden border-t border-border bg-surface py-10 sm:py-14 lg:py-16"
  aria-label="Popular Destinations"
>
  <div class="max-w-[1360px] mx-auto px-4 sm:px-6">
    <div
      class="dest-scroll-container overflow-x-auto pb-4 pt-1 scrollbar-none"
      tabindex="0"
      aria-label="Scrollable destination list"
    >
      <div class="flex flex-col gap-6 sm:gap-8 lg:gap-10 min-w-max xl:min-w-0 justify-center">
        {/* Row 1: International Escapes */}
        <div class="flex items-center justify-start xl:justify-center gap-3.5 sm:gap-4 md:gap-5 lg:gap-6 xl:gap-7">
          {row1.map((item) => (
            <a
              href={item.link}
              class="group flex flex-col items-center gap-2.5 shrink-0 focus-visible:outline-none"
              aria-label={`Explore ${item.name} travel packages`}
            >
              {/* Circular Avatar Container */}
              <div class="relative h-24 w-24 sm:h-26 sm:w-26 md:h-28 md:w-28 lg:h-30 lg:w-30 xl:h-[126px] xl:w-[126px] overflow-hidden rounded-full border border-border/80 bg-surface-muted shadow-xs transition-all duration-300 ease-out group-hover:scale-108 group-hover:border-brand group-hover:shadow-card-hover">
                <Image
                  src={item.image}
                  alt={item.name}
                  class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-112"
                  width={180}
                  widths={[180, 260, 360]}
                  sizes="(min-width: 1280px) 126px, (min-width: 1024px) 120px, (min-width: 768px) 112px, 96px"
                  quality={92}
                />
              </div>
              {/* Clean Destination Name */}
              <span class="font-sans text-xs sm:text-sm lg:text-base font-semibold text-ink transition-colors duration-200 group-hover:font-bold tracking-tight text-center">
                {item.name}
              </span>
            </a>
          ))}
        </div>

        {/* Row 2: Domestic & Himalayan Adventures */}
        <div class="flex items-center justify-start xl:justify-center gap-3.5 sm:gap-4 md:gap-5 lg:gap-6 xl:gap-7">
          {row2.map((item) => (
            <a
              href={item.link}
              class="group flex flex-col items-center gap-2.5 shrink-0 focus-visible:outline-none"
              aria-label={`Explore ${item.name} travel packages`}
            >
              {/* Circular Avatar Container */}
              <div class="relative h-24 w-24 sm:h-26 sm:w-26 md:h-28 md:w-28 lg:h-30 lg:w-30 xl:h-[126px] xl:w-[126px] overflow-hidden rounded-full border border-border/80 bg-surface-muted shadow-xs transition-all duration-300 ease-out group-hover:scale-108 group-hover:border-brand group-hover:shadow-card-hover">
                <Image
                  src={item.image}
                  alt={item.name}
                  class="h-full w-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-112"
                  width={180}
                  widths={[180, 260, 360]}
                  sizes="(min-width: 1280px) 126px, (min-width: 1024px) 120px, (min-width: 768px) 112px, 96px"
                  quality={92}
                />
              </div>
              {/* Clean Destination Name */}
              <span class="font-sans text-xs sm:text-sm lg:text-base font-semibold text-ink transition-colors duration-200 group-hover:font-bold tracking-tight text-center">
                {item.name}
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Clean scrollbar suppression for smooth natural scrolling */
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>

---
import { Image } from 'astro:assets';
import type { Trip } from '../data/trips';
import { bookingLink } from '../data/contact';
import logoMark from '../assets/images/logo-mark.png';

interface Props {
  trip: Trip;
}

const { trip } = Astro.props;

// Clean short location name so it never truncates awkwardly
const shortLocation = trip.location.split(/[,/&]/)[0].trim();
---

<article class="trip-card group relative flex aspect-[3/4] sm:aspect-[4/5] w-full max-w-[275px] sm:max-w-[285px] flex-col overflow-hidden rounded-2xl sm:rounded-3xl shadow-card transition-all duration-300 hover:-translate-y-2 hover:shadow-card-hover bg-ink">
  <a
    href={bookingLink(trip.slug)}
    class="relative flex h-full w-full flex-col overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
    aria-label={`View ${trip.name} package starting from ₹${trip.price}`}
  >
    {/* Ultra-HD Base Photography */}
    <Image
      src={trip.image}
      alt={trip.alt}
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-108"
      widths={[640, 1024, 1400]}
      sizes="(min-width: 1024px) 320px, 280px"
      quality={95}
      loading="lazy"
    />

    {/* Top dark gradient vignette for contrast */}
    <div class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-black/90 via-black/55 to-transparent pointer-events-none"></div>

    {/* Bottom dark gradient vignette */}
    <div class="absolute inset-x-0 bottom-0 h-44 bg-gradient-to-t from-black/90 via-black/50 to-transparent pointer-events-none"></div>

    {/* Top Right Century Holidays Logo Mark */}
    <div class="absolute top-4 right-4 z-20 flex h-7 w-7 items-center justify-center rounded-full bg-black/40 backdrop-blur-md p-1 border border-white/20 shadow-md">
      <Image src={logoMark} alt="Century Holidays Logo" class="h-full w-full object-contain invert brightness-200" />
    </div>

    {/* Top-Centered Typography: Carefully sized so names are properly visible and 100% within card */}
    <div class="relative z-10 flex flex-col items-center pt-5 sm:pt-6 px-4 text-center select-none w-full min-w-0">
      {trip.isGetaway ? (
        <>
          <span class="text-[11px] sm:text-xs font-semibold tracking-wider uppercase text-white/90 drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)]">
            {trip.subtitle || 'Getaways From'}
          </span>
          <h3 class="font-['Syne',sans-serif] font-black text-xl sm:text-2xl uppercase tracking-tight text-white drop-shadow-[0_3px_6px_rgba(0,0,0,0.95)] leading-tight mt-0.5 max-w-full break-words text-center px-1">
            {trip.shortName}
          </h3>
        </>
      ) : (
        <>
          <h3 class="font-['Syne',sans-serif] font-black text-lg sm:text-xl md:text-[22px] uppercase tracking-tight text-white drop-shadow-[0_3px_6px_rgba(0,0,0,0.95)] leading-tight max-w-full break-words text-center px-1">
            {trip.shortName}
          </h3>
          {trip.subtitle && (
            <span class="mt-1 text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.18em] text-brand drop-shadow-[0_2px_4px_rgba(0,0,0,0.9)]">
              {trip.subtitle}
            </span>
          )}
        </>
      )}
    </div>

    {/* Interactive Bottom Glassmorphic Card Drawer */}
    <div class="relative z-10 mt-auto flex flex-col gap-2 p-3.5 sm:p-4 text-text-inverse transition-transform duration-300 w-full min-w-0">
      <div class="flex items-center justify-between gap-2 min-w-0">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-black/60 px-2.5 py-1 text-[11px] font-semibold text-white/95 backdrop-blur-md border border-white/10 shadow-sm shrink-0">
          <i class="ph-bold ph-clock text-brand" aria-hidden="true"></i>
          {trip.duration}
        </span>
        <span class="inline-flex items-center gap-1 text-xs font-semibold text-white/90 drop-shadow min-w-0 truncate">
          <i class="ph-bold ph-map-pin text-brand shrink-0" aria-hidden="true"></i>
          <span class="truncate">{shortLocation}</span>
        </span>
      </div>

      <div class="flex items-center justify-between border-t border-white/20 pt-2 min-w-0">
        <div class="min-w-0">
          <span class="block text-[10px] font-bold uppercase tracking-wider text-white/75">Starting</span>
          <span class="font-display text-lg sm:text-xl font-bold text-white leading-tight drop-shadow truncate block">₹{trip.price}</span>
        </div>

        <span class="inline-flex items-center gap-1.5 rounded-full bg-brand px-3.5 sm:px-4 py-1.5 text-xs font-black text-ink transition-transform duration-200 group-hover:scale-105 group-hover:bg-brand-dim shadow-md shrink-0">
          <span>Book</span>
          <i class="ph-bold ph-arrow-right text-[11px]" aria-hidden="true"></i>
        </span>
      </div>
    </div>
  </a>
</article>

---
// WhyUsSection.astro
// "Why Choose Century Holidays?" - 4 Trust Pillars with Bespoke Vector Craft
// 100% Theme Harmonized: #F0EA1B Brand Yellow, #15140F Dark Ink, Fraunces Serif
//
// Used on the homepage (heading is an <h2>) and as the main content of
// /why-us.html (heading becomes the page's <h1>), so edits here update both.

interface Props {
  /** 'h1' when this section is the whole page, 'h2' when it sits inside one. */
  as?: 'h1' | 'h2';
}

const { as: Heading = 'h2' } = Astro.props;
---

<section id="why-us" class="relative overflow-hidden bg-paper py-16 sm:py-24 border-t border-border">
  {/* Soft Ambient Brand Glow */}
  <div class="pointer-events-none absolute -left-20 top-1/2 -translate-y-1/2 h-80 w-80 rounded-full bg-brand/10 blur-[120px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-20 top-1/2 -translate-y-1/2 h-80 w-80 rounded-full bg-brand/10 blur-[120px]" aria-hidden="true"></div>

  <div class="container-page relative z-10">
    {/* Section Header Matching Uploaded Reference */}
    <div data-reveal class="mx-auto mb-12 sm:mb-16 max-w-3xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-4 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-ink-muted shadow-xs">
        <i class="ph-fill ph-sparkle text-brand text-sm" aria-hidden="true"></i>
        The Century Advantage
      </span>
      <Heading class="mt-3.5 font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-ink tracking-tight">
        Why Choose Century Holidays?
      </Heading>
      <p class="mt-4 text-base sm:text-lg text-text-muted leading-relaxed max-w-2xl mx-auto">
        We make travel seamless, transparent, and genuinely memorable. Here is how we turn your bucket list into a smooth, stress-free reality.
      </p>
    </div>

    {/* 4 Professional Trust Cards with Custom Handcrafted Vectors */}
    {/* 4 Professional Trust Cards with Custom Handcrafted Vectors */}
    <div data-reveal class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-5">
      {/* 1. 10,000+ Happy Explorers */}
      <div class="group flex items-center gap-3.5 rounded-2xl border border-border bg-surface p-4 sm:p-4.5 lg:p-4 xl:p-5 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-brand hover:shadow-card min-w-0 overflow-hidden">
        <div class="relative flex h-12 w-12 sm:h-13 sm:w-13 shrink-0 items-center justify-center rounded-xl bg-brand/20 border border-brand/40 shadow-2xs transition-all duration-300 group-hover:scale-105 group-hover:bg-brand/30">
          <svg class="w-7 h-7 sm:w-8 sm:h-8" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            {/* Explorer 1 (Foreground) */}
            <circle cx="13" cy="11" r="4.5" fill="#F0EA1B" stroke="#15140F" stroke-width="2"/>
            <path d="M5 28.5C5 23.8 8.6 20 13 20C17.4 20 21 23.8 21 28.5" stroke="#15140F" stroke-width="2" stroke-linecap="round"/>
            {/* Explorer 2 (Companion) */}
            <circle cx="23" cy="13" r="3.8" fill="#FFFFFF" stroke="#15140F" stroke-width="2"/>
            <path d="M20.5 21.5C21.8 20.6 23.3 20 25 20C28.3 20 31 22.7 31 26V28.5" stroke="#15140F" stroke-width="2" stroke-linecap="round"/>
            {/* Wanderer details */}
            <path d="M10 24L16 24" stroke="#15140F" stroke-width="2" stroke-linecap="round"/>
            {/* Adventure Star Sparkle */}
            <path d="M29 6L29.7 7.8L31.5 8.5L29.7 9.2L29 11L28.3 9.2L26.5 8.5L28.3 7.8L29 6Z" fill="#F0EA1B" stroke="#15140F" stroke-width="1.2" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <span class="block font-display text-xl sm:text-2xl font-bold text-ink leading-tight tracking-tight truncate">
            10,000+
          </span>
          <span class="block text-xs sm:text-sm font-semibold text-text-muted mt-0.5 truncate">
            Happy Explorers
          </span>
        </div>
      </div>

      {/* 2. 100% Tailored Itineraries */}
      <div class="group flex items-center gap-3.5 rounded-2xl border border-border bg-surface p-4 sm:p-4.5 lg:p-4 xl:p-5 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-brand hover:shadow-card min-w-0 overflow-hidden">
        <div class="relative flex h-12 w-12 sm:h-13 sm:w-13 shrink-0 items-center justify-center rounded-xl bg-brand/20 border border-brand/40 shadow-2xs transition-all duration-300 group-hover:scale-105 group-hover:bg-brand/30">
          <svg class="w-7 h-7 sm:w-8 sm:h-8" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            {/* Folded Map Document */}
            <path d="M6 9.5L14 6.5L22 9.5L30 6.5V26.5L22 29.5L14 26.5L6 29.5V9.5Z" fill="#FFFFFF" stroke="#15140F" stroke-width="2" stroke-linejoin="round"/>
            {/* Map Fold Shading in Brand Yellow */}
            <path d="M14 6.5L22 9.5V29.5L14 26.5V6.5Z" fill="#F0EA1B" fill-opacity="0.4"/>
            {/* Journey Route Trail */}
            <path d="M11 23C13 18 19 22 21 16" stroke="#15140F" stroke-width="2" stroke-linecap="round" stroke-dasharray="2 3"/>
            {/* Destination Map Pin */}
            <path d="M24 10C24 7.8 22.2 6 20 6C17.8 6 16 7.8 16 10C16 13.5 20 18 20 18C20 18 24 13.5 24 10Z" fill="#F0EA1B" stroke="#15140F" stroke-width="2"/>
            <circle cx="20" cy="10" r="1.5" fill="#15140F"/>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <span class="block font-display text-xl sm:text-2xl font-bold text-ink leading-tight tracking-tight truncate">
            100%
          </span>
          <span class="block text-xs sm:text-sm font-semibold text-text-muted mt-0.5 truncate">
            Tailored Itineraries
          </span>
        </div>
      </div>

      {/* 3. 4.9/5 Verified Reviews */}
      <div class="group flex items-center gap-3.5 rounded-2xl border border-border bg-surface p-4 sm:p-4.5 lg:p-4 xl:p-5 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-brand hover:shadow-card min-w-0 overflow-hidden">
        <div class="relative flex h-12 w-12 sm:h-13 sm:w-13 shrink-0 items-center justify-center rounded-xl bg-brand/20 border border-brand/40 shadow-2xs transition-all duration-300 group-hover:scale-105 group-hover:bg-brand/30">
          <svg class="w-7 h-7 sm:w-8 sm:h-8" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            {/* Ribbon Tails */}
            <path d="M13 25L9 32L15 30L17 25" fill="#FFFFFF" stroke="#15140F" stroke-width="2" stroke-linejoin="round"/>
            <path d="M23 25L27 32L21 30L19 25" fill="#FFFFFF" stroke="#15140F" stroke-width="2" stroke-linejoin="round"/>
            {/* Verified Medal Base in Brand Yellow */}
            <circle cx="18" cy="16" r="11.5" fill="#F0EA1B" stroke="#15140F" stroke-width="2"/>
            <circle cx="18" cy="16" r="9" fill="#FFFFFF" stroke="#15140F" stroke-width="1.5"/>
            {/* Five-Point Star in Center */}
            <path d="M18 10.5L19.7 14L23.5 14.5L20.8 17.1L21.4 20.8L18 19L14.6 20.8L15.2 17.1L12.5 14.5L16.3 14L18 10.5Z" fill="#F0EA1B" stroke="#15140F" stroke-width="1.5" stroke-linejoin="round"/>
            {/* Verified Mini Checkmark Badge */}
            <circle cx="25" cy="22" r="4.5" fill="#15140F"/>
            <path d="M23 22L24.5 23.5L27 20.5" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <span class="block font-display text-xl sm:text-2xl font-bold text-ink leading-tight tracking-tight truncate">
            4.9/5
          </span>
          <span class="block text-xs sm:text-sm font-semibold text-text-muted mt-0.5 truncate">
            Verified Reviews
          </span>
        </div>
      </div>

      {/* 4. 0% Hidden Charges */}
      <div class="group flex items-center gap-3.5 rounded-2xl border border-border bg-surface p-4 sm:p-4.5 lg:p-4 xl:p-5 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-brand hover:shadow-card min-w-0 overflow-hidden">
        <div class="relative flex h-12 w-12 sm:h-13 sm:w-13 shrink-0 items-center justify-center rounded-xl bg-brand/20 border border-brand/40 shadow-2xs transition-all duration-300 group-hover:scale-105 group-hover:bg-brand/30">
          <svg class="w-7 h-7 sm:w-8 sm:h-8" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            {/* Trust Shield Base in Brand Yellow */}
            <path d="M18 5L7 9.5V17C7 24.5 11.8 30.5 18 32C24.2 30.5 29 24.5 29 17V9.5L18 5Z" fill="#F0EA1B" stroke="#15140F" stroke-width="2" stroke-linejoin="round"/>
            {/* White Inner Shield */}
            <path d="M18 8L10 11.5V17C10 23 13.5 27.5 18 28.8C22.5 27.5 26 23 26 17V11.5L18 8Z" fill="#FFFFFF" stroke="#15140F" stroke-width="1.5" stroke-linejoin="round"/>
            {/* Bold Indian Rupee Symbol */}
            <path d="M15 13H21M15 16H20M15 13V22M15 16C17.5 16 19 15 19 13.5C19 12 17.5 11 15 11M17 17.5L21 23" stroke="#15140F" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            {/* Verified Checkmark Badge */}
            <circle cx="25" cy="24" r="4.5" fill="#15140F"/>
            <path d="M23 24L24.5 25.5L27 22.5" stroke="#F0EA1B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="min-w-0 flex-1">
          <span class="block font-display text-xl sm:text-2xl font-bold text-ink leading-tight tracking-tight truncate">
            0%
          </span>
          <span class="block text-xs sm:text-sm font-semibold text-text-muted mt-0.5 truncate">
            Hidden Charges
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

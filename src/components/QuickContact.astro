---
import { PHONE_DISPLAY, PHONE_HREF, whatsappLink } from '../data/contact';

interface Props {
  /** Pre-fills the WhatsApp message so the enquiry arrives with page context. */
  message?: string;
}

const { message } = Astro.props;
---

<div class="fixed bottom-5 right-4 z-50 flex flex-col items-end gap-3 sm:bottom-6 sm:right-6">
  <a
    href={PHONE_HREF}
    aria-label={`Call Century Holidays on ${PHONE_DISPLAY}`}
    class="group grid h-12 w-12 place-items-center rounded-full border border-border bg-surface text-xl text-ink shadow-card transition-transform duration-200 hover:-translate-y-0.5 hover:shadow-card-hover"
  >
    <i class="ph-fill ph-phone" aria-hidden="true"></i>
  </a>

  <a
    href={whatsappLink(message)}
    target="_blank"
    rel="noopener"
    class="inline-flex items-center gap-2 rounded-full bg-ink py-3.5 pl-4 pr-5 text-sm font-bold text-text-inverse shadow-panel transition-transform duration-200 hover:-translate-y-0.5"
  >
    <i class="ph-fill ph-whatsapp-logo text-xl text-brand" aria-hidden="true"></i>
    <span>Chat with an expert</span>
  </a>
</div>

---
import { Image } from 'astro:assets';
import bannerSide1 from '../assets/images/banner-side-1.png';
import bannerSide2 from '../assets/images/banner-side-2.jpg';
import bannerSide3 from '../assets/images/banner-side-3.jpg';

const slides = [
  {
    id: 'community-trips',
    titleLine1: 'Solo, Couple Or Friends —',
    titleLine2: 'We Have Trips for All',
    highlightText: 'Trips for All',
    subtitle: 'Most travellers don’t just travel with us, they meet strangers who quickly turn into their people.',
    ctaText: 'Explore Group Trips',
    ctaLink: '#destinations',
    image: bannerSide1,
    alt: 'Solo, Couple Or Friends - We Have Trips for All banner with backpackers and airplane',
    align: 'center',
    theme: 'light',
  },
  {
    id: 'custom-itineraries',
    titleLine1: 'Crafted For You —',
    titleLine2: 'Custom Private Journeys',
    highlightText: 'Private Journeys',
    subtitle: 'Private boutique stays, flexible dates, and custom pacing — planned end-to-end by travel specialists.',
    ctaText: 'Plan Your Custom Trip',
    ctaLink: '/book.html',
    image: bannerSide2,
    alt: 'Custom private journeys with SUV expedition vehicle and scenic mountains',
    align: 'center',
    theme: 'light',
  },
  {
    id: 'transparent-support',
    titleLine1: 'Zero Middlemen —',
    titleLine2: '100% Transparent Holidays',
    highlightText: 'Transparent Holidays',
    subtitle: 'Clear pricing with zero hidden fees, verified luxury stays, and 24/7 dedicated on-trip assistance.',
    ctaText: 'Browse All Packages',
    ctaLink: '#destinations',
    image: bannerSide3,
    alt: 'Luxury resort holiday with verified stays and 24/7 support',
    align: 'center',
    theme: 'light',
  },
];
---

<section
  class="side-banners-section relative w-full bg-surface pb-16 sm:pb-24 pt-4"
  aria-label="Featured Travel Values"
>
  <div class="container-page">
    {/* Banner Carousel Container */}
    <div
      class="side-banners-slider relative mx-auto w-full overflow-hidden rounded-2xl sm:rounded-3xl border border-border/80 bg-white shadow-panel group"
      id="side-banners-slider"
      role="region"
      aria-roledescription="carousel"
      aria-label="Community & Custom Travel Banners"
    >
      {/* Track */}
      <div
        class="side-slider-track flex transition-transform duration-500 ease-out"
        id="side-slider-track"
      >
        {slides.map((slide, idx) => (
          <div
            class="slide-box relative min-w-full shrink-0 aspect-[16/9] sm:aspect-[21/8] md:aspect-[2560/642] overflow-hidden"
            role="group"
            aria-roledescription="slide"
            aria-label={`${idx + 1} of ${slides.length}: ${slide.titleLine1} ${slide.titleLine2}`}
          >
            {/* Background Graphic */}
            <Image
              src={slide.image}
              alt={slide.alt}
              class="absolute inset-0 h-full w-full object-cover object-center"
              widths={[768, 1280, 1920, 2560]}
              sizes="(min-width: 1280px) 1232px, 100vw"
              quality={95}
              priority={idx === 0}
            />

            {/* Soft gradient wash over center to ensure typography matches website theme with maximum contrast */}
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/85 sm:via-white/75 to-transparent pointer-events-none"></div>

            {/* Centered Website Theme Typography */}
            <div class="relative z-10 flex h-full w-full flex-col items-center justify-center p-4 sm:p-8 md:p-12 text-center">
              <div class="max-w-2xl px-2">
                {/* Heading styled with Fraunces Display Serif matching website theme */}
                <h3 class="font-display font-bold text-2xl sm:text-4xl md:text-5xl text-ink leading-[1.1] tracking-tight">
                  <span class="block text-ink">{slide.titleLine1}</span>
                  <span class="block mt-1 text-ink-soft">
                    {slide.titleLine2.replace(slide.highlightText, '')}
                    <span class="relative inline-block text-ink">
                      {slide.highlightText}
                      <span class="absolute -bottom-1 left-0 right-0 h-1.5 sm:h-2 rounded-full bg-brand/70 -z-10"></span>
                    </span>
                  </span>
                </h3>

                {/* Subtitle styled with Outfit Sans text-muted matching website theme */}
                <p class="mt-3 sm:mt-4 text-xs sm:text-base md:text-lg font-sans text-text-muted leading-relaxed max-w-xl mx-auto">
                  {slide.subtitle}
                </p>

                {/* Website Theme Yellow CTA Button */}
                <div class="mt-4 sm:mt-6 flex justify-center">
                  <a
                    href={slide.ctaLink}
                    class="inline-flex items-center gap-2 rounded-full bg-brand px-6 py-2.5 sm:px-7 sm:py-3 text-xs sm:text-sm font-bold text-ink transition-transform duration-200 hover:-translate-y-0.5 hover:shadow-card-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink"
                  >
                    <span>{slide.ctaText}</span>
                    <i class="ph-bold ph-arrow-right text-xs sm:text-sm" aria-hidden="true"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* Prev / Next Controls */}
      <button
        type="button"
        id="side-prev"
        class="absolute left-3 top-1/2 -translate-y-1/2 z-20 flex h-9 w-9 sm:h-11 sm:w-11 items-center justify-center rounded-full bg-white/80 text-ink backdrop-blur-md transition-all hover:bg-brand hover:scale-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink shadow-md opacity-80 group-hover:opacity-100"
        aria-label="Previous slide"
      >
        <i class="ph-bold ph-caret-left text-xl sm:text-2xl" aria-hidden="true"></i>
      </button>
      <button
        type="button"
        id="side-next"
        class="absolute right-3 top-1/2 -translate-y-1/2 z-20 flex h-9 w-9 sm:h-11 sm:w-11 items-center justify-center rounded-full bg-white/80 text-ink backdrop-blur-md transition-all hover:bg-brand hover:scale-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ink shadow-md opacity-80 group-hover:opacity-100"
        aria-label="Next slide"
      >
        <i class="ph-bold ph-caret-right text-xl sm:text-2xl" aria-hidden="true"></i>
      </button>
    </div>

    {/* Side-scrolling Indicator Dots */}
    <div
      class="mt-4 flex items-center justify-center gap-2.5"
      id="side-slider-dots"
      role="tablist"
      aria-label="Side scrolling banner pagination"
    >
      {slides.map((_, i) => (
        <button
          type="button"
          class={`side-dot transition-all duration-300 rounded-full cursor-pointer ${
            i === 0 ? 'w-8 h-2.5 bg-ink' : 'w-2.5 h-2.5 bg-border hover:bg-ink-muted'
          }`}
          data-index={i}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={`Go to slide ${i + 1}`}
        />
      ))}
    </div>
  </div>
</section>

<script>
  function initSideSlider() {
    const slider = document.getElementById('side-banners-slider');
    const track = document.getElementById('side-slider-track') as HTMLElement | null;
    const dots = document.querySelectorAll<HTMLButtonElement>('.side-dot');
    const prevBtn = document.getElementById('side-prev');
    const nextBtn = document.getElementById('side-next');

    if (!track || dots.length === 0) return;

    let currentIndex = 0;
    const totalSlides = dots.length;
    let autoplayTimer: ReturnType<typeof setInterval> | null = null;

    function goToSlide(index: number) {
      currentIndex = (index + totalSlides) % totalSlides;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      dots.forEach((dot, idx) => {
        const isCurrent = idx === currentIndex;
        dot.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
        if (isCurrent) {
          dot.classList.remove('w-2.5', 'bg-border');
          dot.classList.add('w-8', 'bg-ink');
        } else {
          dot.classList.remove('w-8', 'bg-ink');
          dot.classList.add('w-2.5', 'bg-border');
        }
      });
    }

    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = setInterval(() => {
        goToSlide(currentIndex + 1);
      }, 5000);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const index = parseInt(target.getAttribute('data-index') || '0', 10);
        goToSlide(index);
        startAutoplay();
      });
    });

    prevBtn?.addEventListener('click', () => {
      goToSlide(currentIndex - 1);
      startAutoplay();
    });

    nextBtn?.addEventListener('click', () => {
      goToSlide(currentIndex + 1);
      startAutoplay();
    });

    slider?.addEventListener('mouseenter', stopAutoplay);
    slider?.addEventListener('mouseleave', startAutoplay);

    // Touch Swipe
    let touchStartX = 0;
    let touchEndX = 0;

    slider?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoplay();
    }, { passive: true });

    slider?.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) goToSlide(currentIndex + 1);
        else goToSlide(currentIndex - 1);
      }
      startAutoplay();
    }, { passive: true });

    startAutoplay();
  }

  initSideSlider();
  document.addEventListener('astro:page-load', initSideSlider);
</script>


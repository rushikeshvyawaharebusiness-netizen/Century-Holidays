---
// SpecialitiesSection.astro - "Book with Confidence" Guarantee Section
// 100% Harmonized with Century Holidays Theme (#F0EA1B Yellow, #15140F Ink, Fraunces Serif)
---

<section id="specialities" class="relative overflow-hidden border-y border-border bg-surface-muted py-16 sm:py-24">
  {/* Ambient brand yellow glow matching website theme */}
  <div class="pointer-events-none absolute -right-28 -top-28 h-80 w-80 rounded-full bg-brand/15 blur-[100px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-28 -bottom-28 h-80 w-80 rounded-full bg-brand/15 blur-[100px]" aria-hidden="true"></div>

  <div class="container-page relative z-10">
    {/* Section Header with Website Editorial Typography */}
    <div data-reveal class="mx-auto mb-12 sm:mb-16 max-w-2xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3.5 py-1 text-[11px] font-bold uppercase tracking-[0.2em] text-ink-muted shadow-xs">
        <i class="ph-fill ph-shield-check text-brand text-xs" aria-hidden="true"></i>
        Our Guarantee
      </span>
      <h2 class="mt-3 font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-ink tracking-tight">
        Book with Confidence
      </h2>
      <p class="mt-3 text-sm sm:text-base text-text-muted max-w-lg mx-auto">
        Every holiday with Century Holidays comes with flexible terms, verified pricing, and round-the-clock on-trip support.
      </p>
    </div>

    {/* 5 Features Grid in Website Theme Cards */}
    <div data-reveal class="mx-auto max-w-5xl">
      {/* Top Row: 3 Items */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {/* 1. Secure Your Spot with 30% */}
        <div class="group flex items-center gap-4 p-5 sm:p-6 rounded-2xl sm:rounded-3xl bg-surface border border-border shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-brand hover:shadow-card-hover">
          <div class="relative shrink-0 flex items-center justify-center w-16 h-16 transition-transform duration-300 group-hover:scale-108">
            <svg class="w-full h-full" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              {/* Drop Shadow */}
              <ellipse cx="32" cy="58" rx="20" ry="3" fill="#15140F" fill-opacity="0.08"/>
              {/* Shield Base in Brand Yellow */}
              <path d="M30 6L14 13V28C14 41 21 50 30 54C39 50 46 41 46 28V13L30 6Z" fill="#F0EA1B" stroke="#15140F" stroke-width="2.5" stroke-linejoin="round"/>
              <path d="M30 9L17 15V28C17 39 23 47 30 50.5C37 47 43 39 43 28V15L30 9Z" fill="#FFFBEB" fill-opacity="0.4"/>
              {/* Bold Checkmark */}
              <path d="M22 28L27 33L37 23" stroke="#15140F" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/>
              {/* White Rupee Coin */}
              <circle cx="45" cy="20" r="11" fill="#FFFFFF" stroke="#15140F" stroke-width="2.5"/>
              <text x="45" y="25" text-anchor="middle" font-family="'Outfit', sans-serif" font-size="13" font-weight="900" fill="#15140F">₹</text>
              {/* 30% Badge Tag */}
              <rect x="14" y="41" width="30" height="16" rx="4" fill="#FFFFFF" stroke="#15140F" stroke-width="2"/>
              <text x="29" y="53" text-anchor="middle" font-family="'Outfit', sans-serif" font-size="10" font-weight="900" fill="#15140F">30%</text>
            </svg>
          </div>
          <span class="font-sans font-bold text-base sm:text-lg text-ink leading-snug">
            Secure Your Spot by Paying 30% of the Trip
          </span>
        </div>

        {/* 2. Zero-Cost EMI */}
        <div class="group flex items-center gap-4 p-5 sm:p-6 rounded-2xl sm:rounded-3xl bg-surface border border-border shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-brand hover:shadow-card-hover">
          <div class="relative shrink-0 flex items-center justify-center w-16 h-16 transition-transform duration-300 group-hover:scale-108">
            <svg class="w-full h-full" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="30" cy="56" rx="20" ry="3" fill="#15140F" fill-opacity="0.08"/>
              {/* Back Banknote */}
              <rect x="7" y="22" width="43" height="26" rx="3.5" transform="rotate(-6 7 22)" fill="#FEF08A" stroke="#15140F" stroke-width="2.5"/>
              {/* Front Banknote in Brand Yellow */}
              <rect x="9" y="25" width="43" height="26" rx="3.5" fill="#F0EA1B" stroke="#15140F" stroke-width="2.5"/>
              <circle cx="30.5" cy="38" r="6.5" fill="#FFFFFF" stroke="#15140F" stroke-width="1.5"/>
              <text x="30.5" y="42" text-anchor="middle" font-family="'Outfit', sans-serif" font-size="10" font-weight="900" fill="#15140F">₹</text>
              {/* 0% Badge */}
              <circle cx="15" cy="17" r="10" fill="#FFFFFF" stroke="#15140F" stroke-width="2"/>
              <text x="15" y="21" text-anchor="middle" font-family="'Outfit', sans-serif" font-size="9" font-weight="900" fill="#15140F">0%</text>
              {/* Airplane in Ink */}
              <path d="M41 15L53 12L48 19L43 18L40 20L41 17L38 17L41 15Z" fill="#15140F"/>
            </svg>
          </div>
          <span class="font-sans font-bold text-base sm:text-lg text-ink leading-snug">
            Book Your Trip on Easy Zero-Cost EMI
          </span>
        </div>

        {/* 3. Transparent Cancellation Policy */}
        <div class="group flex items-center gap-4 p-5 sm:p-6 rounded-2xl sm:rounded-3xl bg-surface border border-border shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-brand hover:shadow-card-hover">
          <div class="relative shrink-0 flex items-center justify-center w-16 h-16 transition-transform duration-300 group-hover:scale-108">
            <svg class="w-full h-full" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="27" cy="56" rx="16" ry="3" fill="#15140F" fill-opacity="0.08"/>
              {/* Ticket Document */}
              <rect x="10" y="10" width="34" height="44" rx="4" fill="#FFFFFF" stroke="#15140F" stroke-width="2.5"/>
              <line x1="16" y1="28" x2="32" y2="28" stroke="#15140F" stroke-width="2" stroke-linecap="round"/>
              <line x1="16" y1="34" x2="28" y2="34" stroke="#15140F" stroke-width="2" stroke-linecap="round"/>
              <line x1="16" y1="40" x2="30" y2="40" stroke="#15140F" stroke-width="2" stroke-linecap="round"/>
              {/* Status Box */}
              <rect x="14" y="14" width="12" height="10" rx="2" fill="#FEF08A" stroke="#15140F" stroke-width="1.5"/>
              <path d="M17 19L20 22L24 16" stroke="#15140F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              {/* Yellow Airplane Circle Badge */}
              <circle cx="44" cy="38" r="13" fill="#F0EA1B" stroke="#15140F" stroke-width="2.5"/>
              <path d="M44 29L47 37L54 39L46 41L45 46L43 42L39 42L42 39L38 37L44 29Z" fill="#15140F"/>
            </svg>
          </div>
          <span class="font-sans font-bold text-base sm:text-lg text-ink leading-snug">
            Transparent Cancellation Policy
          </span>
        </div>
      </div>

      {/* Bottom Row: 2 Items Centered */}
      <div class="mt-6 sm:mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 max-w-4xl mx-auto">
        {/* 4. Flexible Trip Rescheduling Options */}
        <div class="group flex items-center gap-4 p-5 sm:p-6 rounded-2xl sm:rounded-3xl bg-surface border border-border shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-brand hover:shadow-card-hover">
          <div class="relative shrink-0 flex items-center justify-center w-16 h-16 transition-transform duration-300 group-hover:scale-108">
            <svg class="w-full h-full" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="30" cy="55" rx="16" ry="3" fill="#15140F" fill-opacity="0.08"/>
              {/* Calendar Base */}
              <rect x="12" y="14" width="36" height="38" rx="5" fill="#FFFFFF" stroke="#15140F" stroke-width="2.5"/>
              <path d="M12 24H48" stroke="#15140F" stroke-width="2"/>
              {/* Spiral Rings */}
              <line x1="20" y1="10" x2="20" y2="15" stroke="#15140F" stroke-width="3" stroke-linecap="round"/>
              <line x1="40" y1="10" x2="40" y2="15" stroke="#15140F" stroke-width="3" stroke-linecap="round"/>
              {/* Clock Dial */}
              <circle cx="27" cy="36" r="8" fill="#FFFBEB" stroke="#15140F" stroke-width="2"/>
              <path d="M27 32V36L30 38" stroke="#15140F" stroke-width="2" stroke-linecap="round"/>
              {/* Brand Yellow Rescheduling Badge */}
              <circle cx="43" cy="42" r="11" fill="#F0EA1B" stroke="#15140F" stroke-width="2"/>
              <path d="M40 40A4 4 0 1 1 43 46M43 46V43M43 46H46" stroke="#15140F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="font-sans font-bold text-base sm:text-lg text-ink leading-snug">
            Flexible Trip Rescheduling Options
          </span>
        </div>

        {/* 5. 24*7 Support & Trained Trip Captains */}
        <div class="group flex items-center gap-4 p-5 sm:p-6 rounded-2xl sm:rounded-3xl bg-surface border border-border shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-brand hover:shadow-card-hover">
          <div class="relative shrink-0 flex items-center justify-center w-16 h-16 transition-transform duration-300 group-hover:scale-108">
            <svg class="w-full h-full" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
              <ellipse cx="23" cy="54" rx="14" ry="3" fill="#15140F" fill-opacity="0.08"/>
              {/* Captain / Guide */}
              <circle cx="23" cy="22" r="9" fill="#FFFFFF" stroke="#15140F" stroke-width="2.5"/>
              <path d="M9 44C9 36 15 33 23 33C31 33 37 36 37 44" fill="#FFFFFF" stroke="#15140F" stroke-width="2.5"/>
              {/* Brand Yellow Call Bubble with Phone */}
              <circle cx="42" cy="22" r="12" fill="#F0EA1B" stroke="#15140F" stroke-width="2.5"/>
              <path d="M38 18C41 18 43 20 44 23M39 21C40.5 21 41.5 22 42 23.5" stroke="#15140F" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M37 25C36 24 37 22.5 38 21.5C39 20.5 40 21 40.5 21.5L42 23C42.5 23.5 42 24.5 41.5 25C40.5 26 39.5 27 38.5 27C37.5 27 36 26 37 25Z" fill="#15140F"/>
              {/* 24/7 Tag */}
              <rect x="20" y="42" width="29" height="15" rx="3.5" fill="#FFFFFF" stroke="#15140F" stroke-width="2"/>
              <text x="34.5" y="53" text-anchor="middle" font-family="'Outfit', sans-serif" font-size="9" font-weight="900" fill="#15140F">24/7</text>
            </svg>
          </div>
          <span class="font-sans font-bold text-base sm:text-lg text-ink leading-snug">
            24*7 Support &amp; Trained Trip Captains
          </span>
        </div>
      </div>
    </div>

    {/* Terms & Conditions Notice */}
    <div data-reveal class="mt-10 sm:mt-14 text-right">
      <span class="text-xs font-semibold text-text-muted/80 tracking-wide">
        T&amp;C applied*
      </span>
    </div>
  </div>
</section>

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "new-century-holidays-website.vercel.app" }],
      "destination": "https://centuryholidays.in/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "new-century-holidays-website.vercel.app" }],
      "destination": "https://centuryholidays.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "new-century-holidays-website.vercel.app" }],
      "destination": "https://centuryholidays.in/:path*",
      "permanent": true
    }
  ]
}
